{{define "field_bool"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}
{{$style := index $meta "style"}}
{{if not $style}}{{$style = "select"}}{{end}}

{{if eq $style "checkbox"}}
<div class="form-check">
    <input class="form-check-input" type="checkbox" 
           id="{{$name}}" 
           name="{{$name}}" 
           value="true"
           {{if eq $value true}}checked{{end}}
           {{if $readonly}}disabled{{end}}>
    <label class="form-check-label" for="{{$name}}">{{t .Locale "Yes"}}</label>
</div>

{{else if eq $style "switch"}}
<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch"
           id="{{$name}}" 
           name="{{$name}}" 
           value="true"
           {{if eq $value true}}checked{{end}}
           {{if $readonly}}disabled{{end}}>
    <label class="form-check-label" for="{{$name}}">{{t .Locale "Yes"}}</label>
</div>

{{else}}
{{/* Default: select dropdown */}}
<select class="form-select" 
        id="{{$name}}" 
        name="{{$name}}"
        {{if $required}}required{{end}}
        {{if $readonly}}disabled{{end}}>
    <option value="">Selecione...</option>
    <option value="true" {{if eq $value true}}selected{{end}}>{{t .Locale "Yes"}}</option>
    <option value="false" {{if eq $value false}}selected{{end}}>{{t .Locale "No"}}</option>
</select>
{{end}}
{{end}}

{{define "field_options_bool"}}
{{$meta := .Meta}}
        <div id="field-options-bool" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_bool_style" class="form-label small">{{t .Locale "Display style"}}</label>
                <select class="form-select form-select-sm plugin-option" id="opt_bool_style" data-key="style">
                    <option value="select" {{if eq (index $meta "style") "select"}}selected{{end}}>{{t .Locale "Dropdown (Yes/No)"}}</option>
                    <option value="checkbox" {{if eq (index $meta "style") "checkbox"}}selected{{end}}>Checkbox</option>
                    <option value="switch" {{if eq (index $meta "style") "switch"}}selected{{end}}>Switch</option>
                </select>
            </div>
        </div>
{{end}}
