{{define "eav_ui_group_edit"}}
{{ $style := .Options.Style }}
{{ if or (eq $style "") (eq $style "card") }}
<div class="card mb-3">
  <div class="card-header">
    <div class="d-flex flex-column gap-1">
      <div class="fw-semibold">{{.Context.Field.Label}}</div>
      {{if .Options.Subtitle}}
      <small class="text-muted">{{.Options.Subtitle}}</small>
      {{end}}
    </div>
  </div>
  <div class="card-body">
    {{if .ChildrenRowsEdit}}
      {{range .ChildrenRowsEdit}}
      <div class="row g-3 mb-1">
        {{range .Children}}
        <div class="col-md-{{.ColumnWidth}}">{{.Content}}</div>
        {{end}}
      </div>
      {{end}}
    {{end}}
  </div>
</div>
{{else}}
<div class="mb-3">
  {{if .Context.Field.Label}}
  <h3 class="h6 mb-2">{{.Context.Field.Label}}</h3>
  {{end}}
  {{if .ChildrenRowsEdit}}
    {{range .ChildrenRowsEdit}}
    <div class="row g-3 mb-1">
      {{range .Children}}
      <div class="col-md-{{.ColumnWidth}}">{{.Content}}</div>
      {{end}}
    </div>
    {{end}}
  {{end}}
</div>
{{end}}
{{end}}
