{{define "eav_ui_audio_edit"}}
{{- $label := .Context.Field.Label -}}
{{- $previewID := printf "audio-preview-%s" .InputName -}}
{{- $placeholderID := printf "audio-placeholder-%s" .InputName -}}
<div class="mb-3" data-eav-audio-field="true">
  {{if $label}}
    <label for="{{.InputName}}" class="form-label">{{$label}}
      {{if .Context.Field.Required}}<span class="text-danger">*</span>{{end}}
      {{if .ReadOnly}}<span class="badge text-bg-secondary ms-2">Somente leitura</span>{{end}}
    </label>
  {{end}}
  <div class="eav-audio-field">
    <div class="eav-audio-wrapper flex-grow-1">
      <div id="{{$placeholderID}}" class="eav-audio-placeholder{{if .Value}} d-none{{end}}" aria-label="{{if $label}}{{$label}}{{else}}{{.Context.Field.MachineName}}{{end}}">
        <div class="text-center">
          {{template "icon-audio" .}}
          <div class="small text-body-secondary mt-2">Nenhum áudio selecionado</div>
        </div>
      </div>
      <div id="{{$previewID}}" class="eav-audio-preview{{if not .Value}} d-none{{end}}">
        {{if .Value}}
          <audio src="{{.Value}}" class="w-100 eav-ui-audio-player" data-placeholder-id="{{$placeholderID}}" controls></audio>
        {{end}}
      </div>
    </div>
    {{if not .ReadOnly}}
      <div class="eav-audio-actions">
        <button type="button" class="btn btn-outline-secondary eav-audio-btn" data-eav-audio-open="true" data-eav-audio-input="{{.InputName}}" data-eav-audio-preview="{{$previewID}}" data-eav-audio-placeholder="{{$placeholderID}}" aria-label="Selecionar áudio">
          {{template "icon-pencil" .}}
          <span class="visually-hidden">Selecionar áudio</span>
        </button>
        <button type="button" class="btn btn-outline-secondary eav-audio-btn eav-audio-clear-btn" data-eav-audio-input="{{.InputName}}" data-eav-audio-preview="{{$previewID}}" data-eav-audio-placeholder="{{$placeholderID}}" aria-label="Remover áudio">
          {{template "icon-trash" .}}
          <span class="visually-hidden">Remover áudio</span>
        </button>
      </div>
    {{end}}
  </div>
  <input type="hidden" name="{{.InputName}}" id="{{.InputName}}" value="{{.Value}}">
  <div class="form-text"><code>{{.Context.Field.MachineName}}</code></div>
  {{if .Error}}
    <div class="text-danger small">{{.Error}}</div>
  {{end}}
</div>
{{end}}
