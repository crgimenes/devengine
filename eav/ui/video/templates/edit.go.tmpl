{{define "eav_ui_video_edit"}}
{{- $label := .Context.Field.Label -}}
{{- $previewID := printf "video-preview-%s" .InputName -}}
{{- $placeholderID := printf "video-placeholder-%s" .InputName -}}
<div class="mb-3" data-eav-video-field="true">
  {{if $label}}
    <label for="{{.InputName}}" class="form-label">{{$label}}
      {{if .Context.Field.Required}}<span class="text-danger">*</span>{{end}}
      {{if .ReadOnly}}<span class="badge text-bg-secondary ms-2">Somente leitura</span>{{end}}
    </label>
  {{end}}
  <div class="eav-video-field">
    <div class="eav-video-wrapper flex-grow-1">
      <div id="{{$placeholderID}}" class="eav-video-placeholder{{if .Value}} d-none{{end}}" aria-label="{{if $label}}{{$label}}{{else}}{{.Context.Field.MachineName}}{{end}}">
        <div class="text-center">
          {{template "icon-video" .}}
          <div class="small text-body-secondary mt-2">Nenhum vídeo selecionado</div>
        </div>
      </div>
      <div id="{{$previewID}}" class="eav-video-preview{{if not .Value}} d-none{{end}}">
        {{if .Value}}
          <video src="{{.Value}}" class="eav-ui-video-player" data-placeholder-id="{{$placeholderID}}" controls loop muted playsinline></video>
        {{end}}
      </div>
    </div>
    {{if not .ReadOnly}}
      <div class="eav-video-actions">
        <button type="button" class="btn btn-outline-secondary eav-video-btn" data-eav-video-open="true" data-eav-video-input="{{.InputName}}" data-eav-video-preview="{{$previewID}}" data-eav-video-placeholder="{{$placeholderID}}" aria-label="Selecionar vídeo">
          {{template "icon-pencil" .}}
          <span class="visually-hidden">Selecionar vídeo</span>
        </button>
        <button type="button" class="btn btn-outline-secondary eav-video-btn eav-video-clear-btn" data-eav-video-input="{{.InputName}}" data-eav-video-preview="{{$previewID}}" data-eav-video-placeholder="{{$placeholderID}}" aria-label="Remover vídeo">
          {{template "icon-trash" .}}
          <span class="visually-hidden">Remover vídeo</span>
        </button>
      </div>
    {{end}}
  </div>
  <input type="hidden" name="{{.InputName}}" id="{{.InputName}}" value="{{.Value}}">
  <div class="form-text"><code>{{.Context.Field.MachineName}}</code></div>
  {{if .Error}}
    <div class="text-danger small">{{.Error}}</div>
  {{end}}
</div>
{{end}}
