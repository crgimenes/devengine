{{define "field_text"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}
<input type="text"
       class="form-control"
       id="{{$name}}"
       name="{{$name}}"
       value="{{$value}}"
       {{if index $meta "placeholder"}}placeholder="{{index $meta "placeholder"}}"{{end}}
       {{if and (index $meta "max_length") (gt (index $meta "max_length") 0)}}maxlength="{{index $meta "max_length"}}"{{end}}
       {{if index $meta "pattern"}}pattern="{{index $meta "pattern"}}"{{end}}
       {{if index $meta "input_mode"}}inputmode="{{index $meta "input_mode"}}"{{end}}
       {{if $required}}required{{end}}
       {{if $readonly}}readonly{{end}}>
{{end}}

{{define "field_options_text"}}
{{$meta := .Meta}}
        <div id="field-options-text" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_text_placeholder" class="form-label small">Placeholder</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_text_placeholder"
                       data-key="placeholder" value="{{index $meta "placeholder"}}">
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label for="opt_text_max_length" class="form-label small">{{t .Locale "Maximum length"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_text_max_length"
                           data-key="max_length" value="{{index $meta "max_length"}}" min="0">
                </div>
                <div class="col-md-6 mb-2">
                    <label for="opt_text_input_mode" class="form-label small">{{t .Locale "Input mode"}}</label>
                    <select class="form-select form-select-sm plugin-option" id="opt_text_input_mode" data-key="input_mode">
                        <option value="text" {{if eq (index $meta "input_mode") "text"}}selected{{end}}>{{t .Locale "Text"}}</option>
                        <option value="email" {{if eq (index $meta "input_mode") "email"}}selected{{end}}>Email</option>
                        <option value="tel" {{if eq (index $meta "input_mode") "tel"}}selected{{end}}>{{t .Locale "Telephone"}}</option>
                        <option value="url" {{if eq (index $meta "input_mode") "url"}}selected{{end}}>URL</option>
                    </select>
                </div>
            </div>
        </div>
{{end}}
