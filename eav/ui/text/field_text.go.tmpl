{{define "field_text"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}
<input type="text" 
       class="form-control" 
       id="{{$name}}" 
       name="{{$name}}"
       value="{{$value}}"
       {{if index $meta "placeholder"}}placeholder="{{index $meta "placeholder"}}"{{end}}
       {{if and (index $meta "maxLength") (gt (index $meta "maxLength") 0)}}maxlength="{{index $meta "maxLength"}}"{{end}}
       {{if index $meta "pattern"}}pattern="{{index $meta "pattern"}}"{{end}}
       {{if index $meta "inputMode"}}inputmode="{{index $meta "inputMode"}}"{{end}}
       {{if $required}}required{{end}}
       {{if $readonly}}readonly{{end}}>
{{end}}

{{define "field_options_text"}}
{{$meta := .Meta}}
        <div id="field-options-text" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_text_placeholder" class="form-label small">Placeholder</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_text_placeholder" 
                       data-key="placeholder" value="{{index $meta "placeholder"}}">
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label for="opt_text_maxLength" class="form-label small">{{t .Locale "Maximum length"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_text_maxLength" 
                           data-key="maxLength" value="{{index $meta "maxLength"}}" min="0">
                </div>
                <div class="col-md-6 mb-2">
                    <label for="opt_text_inputMode" class="form-label small">Modo de entrada</label>
                    <select class="form-select form-select-sm plugin-option" id="opt_text_inputMode" data-key="inputMode">
                        <option value="text" {{if eq (index $meta "inputMode") "text"}}selected{{end}}>Texto</option>
                        <option value="email" {{if eq (index $meta "inputMode") "email"}}selected{{end}}>Email</option>
                        <option value="tel" {{if eq (index $meta "inputMode") "tel"}}selected{{end}}>Telefone</option>
                        <option value="url" {{if eq (index $meta "inputMode") "url"}}selected{{end}}>URL</option>
                    </select>
                </div>
            </div>
        </div>
{{end}}
