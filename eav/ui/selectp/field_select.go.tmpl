{{define "field_select"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}
{{$options := index $meta "options"}}
{{$allowEmpty := index $meta "allowEmpty"}}
{{$multiple := index $meta "multiple"}}
<select class="form-select" 
        id="{{$name}}" 
        name="{{$name}}"
        {{if $multiple}}multiple{{end}}
        {{if $required}}required{{end}}
        {{if $readonly}}disabled{{end}}>
    {{if $allowEmpty}}
    <option value="">{{t .Locale "Select…"}}</option>
    {{end}}
    {{range $options}}
    {{if eq (printf "%T" .) "map[string]interface {}"}}
    {{/* Option with label and value: {"value": "x", "label": "Y"} */}}
    <option value="{{index . "value"}}" {{if eq $value (index . "value")}}selected{{end}}>
        {{index . "label"}}
    </option>
    {{else}}
    {{/* Simple string option */}}
    <option value="{{.}}" {{if eq $value .}}selected{{end}}>{{.}}</option>
    {{end}}
    {{end}}
</select>
{{end}}

{{define "field_options_select"}}
{{$meta := .Meta}}
        <div id="field-options-select" class="field-ui-options d-none">
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_select_allowEmpty" 
                       data-key="allowEmpty" {{if index $meta "allowEmpty"}}checked{{end}}>
                <label class="form-check-label" for="opt_select_allowEmpty">
                    {{t .Locale "Allow an empty option"}}
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_select_multiple" 
                       data-key="multiple" {{if index $meta "multiple"}}checked{{end}}>
                <label class="form-check-label" for="opt_select_multiple">
                    {{t .Locale "Multiple selection"}}
                </label>
            </div>
            <p class="small text-muted">{{t .Locale "Options are configured directly in the JSON below."}}</p>
        </div>
{{end}}
