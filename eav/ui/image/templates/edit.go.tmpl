{{define "eav_ui_image_edit"}}
{{- $label := .Context.Field.Label -}}
{{- $previewID := printf "image-preview-%s" .InputName -}}
{{- $placeholderID := printf "image-placeholder-%s" .InputName -}}
<div class="mb-3" data-eav-image-field="true">
  {{if $label}}
    <label for="{{.InputName}}" class="form-label">{{$label}}
      {{if .Context.Field.Required}}<span class="text-danger">*</span>{{end}}
      {{if .ReadOnly}}<span class="badge text-bg-secondary ms-2">Somente leitura</span>{{end}}
    </label>
  {{end}}
  <div class="eav-image-field">
    <div class="eav-image-wrapper flex-grow-1">
      <div id="{{$placeholderID}}" class="eav-image-placeholder{{if .Value}} d-none{{end}}" aria-label="{{if $label}}{{$label}}{{else}}{{.Context.Field.MachineName}}{{end}}">
        <div class="text-center">
          {{template "icon-image" .}}
          <div class="small text-body-secondary mt-2">Nenhuma imagem selecionada</div>
        </div>
      </div>
      <div id="{{$previewID}}" class="eav-image-preview{{if not .Value}} d-none{{end}}">
        {{if .Value}}
          <img src="{{.Value}}" alt="{{if $label}}{{$label}}{{else}}Imagem selecionada{{end}}" class="rounded eav-ui-image-preview" loading="lazy" data-placeholder-id="{{$placeholderID}}">
        {{end}}
      </div>
    </div>
    {{if not .ReadOnly}}
      <div class="eav-image-actions">
        <button type="button" class="btn btn-outline-secondary eav-image-btn eav-image-open-btn" data-eav-image-open="true" data-eav-image-input="{{.InputName}}" data-eav-image-preview="{{$previewID}}" data-eav-image-placeholder="{{$placeholderID}}" aria-label="Selecionar imagem">
          {{template "icon-pencil" .}}
          <span class="visually-hidden">Selecionar imagem</span>
        </button>
        <button type="button" class="btn btn-outline-secondary eav-image-btn eav-image-clear-btn" data-eav-image-input="{{.InputName}}" data-eav-image-preview="{{$previewID}}" data-eav-image-placeholder="{{$placeholderID}}" aria-label="Remover imagem">
          {{template "icon-trash" .}}
          <span class="visually-hidden">Remover imagem</span>
        </button>
      </div>
    {{end}}
  </div>
  <input type="hidden" name="{{.InputName}}" id="{{.InputName}}" value="{{.Value}}">
  <div class="form-text"><code>{{.Context.Field.MachineName}}</code></div>
  {{if .Error}}
    <div class="text-danger small">{{.Error}}</div>
  {{end}}
</div>
{{end}}
