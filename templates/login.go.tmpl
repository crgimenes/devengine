<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "navbar" .}}

    <main class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title text-center mb-4">{{t $.Locale "Sign in"}}</h1>

                        {{if .Error}}
                        <div class="alert alert-danger" role="alert">
                            {{.Error}}
                        </div>
                        {{end}}

                        <form method="post" action="/login" autocomplete="on">
                            <div class="mb-3">
                                <label for="username" class="form-label">{{t $.Locale "Username"}}</label>
                                <input type="text"
                                       class="form-control"
                                       id="username"
                                       name="username"
                                       autocomplete="username"
                                       required>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">{{t $.Locale "Password"}}</label>
                                <input type="password"
                                       class="form-control"
                                       id="password"
                                       name="password"
                                       autocomplete="current-password"
                                       required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                {{t $.Locale "Sign in"}}
                            </button>
                        </form>

                        <p class="text-center text-muted mt-4 small mb-0">
                            {{t $.Locale "Invite-only access. Ask the administrator for a link."}}
                        </p>
                    </div>
                </div>

                <p class="text-center text-muted mt-4 small">
                    <a href="/" class="text-decoration-none">{{t $.Locale "Back to home"}}</a>
                </p>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
</body>

</html>
