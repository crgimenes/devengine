<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "navbar" .}}

    <main class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title text-center mb-4">Entrar</h1>

                        <!-- OAuth Providers -->
                        {{if or .Config.DiscordOAuthEnabled 
                        .Config.GithubOAuthEnabled }}
                        <div class="mb-4">
                            <h6 class="card-subtitle mb-3">Conectar com:</h6>
                            {{if .Config.DiscordOAuthEnabled}}
                                <a href="/login/discord" 
                                    class="btn btn-primary w-100 mb-2" 
                                    rel="nofollow">
                                    <i class="bi bi-discord"></i> Discord
                                </a>
                            {{end}}
                            {{if .Config.GithubOAuthEnabled}}
                                <a href="/login/github" 
                                    class="btn btn-primary w-100 mb-2" 
                                    rel="nofollow">
                                    <i class="bi bi-github"></i> GitHub
                                </a>
                            {{end}}
                        </div>

                        <!-- Divider -->
                        <div class="mb-4">
                            <hr>
                            <div class="text-center text-muted auth-divider">
                                <span>ou</span>
                            </div>
                        </div>

                        {{end}}

                        <!-- Magic Link Form -->
                        <form method="post" action="/login/magic_link" id="magicLinkForm">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email" 
                                    placeholder="seu@email.com" required>
                                <small class="form-text text-muted">
                                    Enviaremos um link de login para seu email
                                </small>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                Enviar Link de Login
                            </button>
                        </form>

                        <!-- Status Messages -->
                        <div id="messageContainer"></div>
                    </div>
                </div>

                <!-- Info -->
                <p class="text-center text-muted mt-4 small">
                    Ao prosseguir, voce concorda com o uso de cookies de sessao.<br>
                    <a href="/" class="text-decoration-none">Voltar a home</a>
                </p>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}

    <script src="/assets/login.js"></script>
</body>

</html>

