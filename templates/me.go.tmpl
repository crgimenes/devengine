<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "navbar" .}}

    <main class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title mb-4">{{t $.Locale "My profile"}}</h1>

                        {{if .Error}}
                            <div class="alert alert-danger alert-dismissible fade show" 
                                role="alert">
                                {{.Error}}
                                <button type="button" 
                                    class="btn-close" 
                                    data-bs-dismiss="alert" 
                                    aria-label="Close"></button>
                            </div>
                        {{end}}

                        {{if .Message}}
                            <div class="alert alert-success alert-dismissible fade show" 
                                role="alert">
                                {{.Message}}
                                <button type="button" 
                                    class="btn-close" 
                                    data-bs-dismiss="alert" 
                                    aria-label="Close"></button>
                            </div>
                        {{end}}

                        <form method="POST" 
                            action="/me" 
                            class="needs-validation"
                            enctype="multipart/form-data"
                            novalidate>

                            <!-- Email (opcional) -->
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email"
                                    value="{{.User.Email}}" autocomplete="email">
                                <small class="form-text text-muted">Opcional. Usado para receber convites e notificacoes.</small>
                            </div>

                            <div class="mb-3">
                                <label for="locale" class="form-label">{{t $.Locale "Language"}}</label>
                                <select class="form-select" id="locale" name="locale">
                                    <option value="" {{if not .User.Locale}}selected{{end}}>{{t $.Locale "Automatic (browser language)"}}</option>
                                    {{$user := .User}}
                                    {{range .Locales}}
                                    <option value="{{.}}" {{if eq $user.Locale .}}selected{{end}}>{{.}}</option>
                                    {{end}}
                                </select>
                                <small class="form-text text-muted">{{t $.Locale "Used for system messages and screens."}}</small>
                            </div>

                            <!-- Username -->
                            <div class="mb-3">
                                <label for="username" 
                                    class="form-label">{{t $.Locale "Username"}}</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="username" 
                                       name="username" 
                                    value="{{.User.Username}}" required
                                    placeholder="{{t $.Locale "Pick a username"}}"
                                    autofocus>
                                <small class="form-text text-muted">
                                    O nome de usuario deve ser unico e unico em todo o sistema
                                </small>
                            </div>

                            <!-- Avatar URL -->
                            <div class="mb-3">
                                {{if .User.AvatarURL}}
                                    <img src="{{.User.AvatarURL}}" alt="Avatar do usuario" 
                                        class="rounded-circle mt-2" style="object-fit: cover; width: 100px; height: 100px; aspect-ratio: 1/1;">
                                {{end}}
                            </div>

                            <!-- File Upload -->
                            <div class="mb-3">
                                <label for="avatar_file" class="form-label">{{t $.Locale "Avatar upload"}}</label>
                                <input class="form-control" 
                                        type="file" 
                                        id="avatar_file"
                                        name="avatar_file"
                                        accept="image/*">
                            </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">{{t $.Locale "Save profile"}}</button>
                                <a href="/" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Account Info -->
                <div class="card mt-4">
                    <div class="card-body">
                        <h6 class="card-title">{{t $.Locale "Account information"}}</h6>
                        <p class="mb-1"><small><strong>ID:</strong> {{.User.ID}}</small></p>
                        <p class="mb-1"><small><strong>Email:</strong> {{.User.Email}}</small></p>
                        <p class="mb-1"><small><strong>Status:</strong> 
                            {{if .User.Enabled}}
                                <span class="badge bg-success">Ativa</span>
                            {{else}}
                                <span class="badge bg-warning">Incompleta</span>
                            {{end}}
                        </small></p>
                    </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <h6 class="card-title">{{t $.Locale "API tokens"}}</h6>
                        <p class="small text-muted">{{t $.Locale "Bearer tokens for the REST API (/api/v1). The token value is shown only once, right after it is created."}}</p>
                        {{if .NewToken}}
                        <div class="alert alert-success" role="alert">
                            {{t $.Locale "Token created. Copy it now; it will not be shown again:"}}
                            <code id="new-api-token" class="user-select-all d-block mt-2">{{.NewToken}}</code>
                        </div>
                        {{end}}
                        {{if .Tokens}}
                        <ul class="list-group list-group-flush mb-3">
                            {{range .Tokens}}
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>
                                    {{if .Label}}{{.Label}}{{else}}<span class="text-muted">{{t $.Locale "(no label)"}}</span>{{end}}
                                    <small class="text-muted d-block">{{t $.Locale "created"}} {{.CreatedAt.Format "2006-01-02 15:04"}}</small>
                                </span>
                                <form method="post" action="/me/api-tokens/{{.ID}}/delete" class="mb-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{t $.Locale "Revoke"}}</button>
                                </form>
                            </li>
                            {{end}}
                        </ul>
                        {{end}}
                        <form method="post" action="/me/api-tokens" class="d-flex gap-2">
                            <input type="text" class="form-control form-control-sm" name="label"
                                   placeholder="{{t $.Locale "Label (e.g. ci script)"}}" maxlength="80">
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">{{t $.Locale "Create token"}}</button>
                        </form>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
</body>

</html>

