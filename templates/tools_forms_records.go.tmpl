<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
        <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
            {{.Message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3 gap-3 flex-wrap">
                        <div>
                            <h2 class="mb-1">Registros de {{.Form.Label}}</h2>
                            <p class="text-muted mb-0">
                                Entity: <code>{{.EntityType.MachineName}}</code> · Form: <code>{{.Form.MachineName}}</code>
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/form/{{.Form.MachineName}}" class="btn btn-success">
                                <i class="bi bi-plus-lg"></i> Novo
                            </a>
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records/export.csv"
                               class="btn btn-outline-secondary">CSV</a>
                            <a href="/tools/forms/{{.Form.ReferenceID}}/edit"
                               class="btn btn-outline-primary">{{t $.Locale "Edit form"}}</a>
                        </div>
                    </div>

                    <form method="get" action="/tools/forms/{{.Form.ReferenceID}}/records" class="mb-3">
                        <div class="input-group">
                            <input type="text" name="q" class="form-control"
                                   placeholder="{{t $.Locale "Search text fields…"}}"
                                   value="{{.Filter}}">
                            {{if .Filter}}
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records"
                               class="btn btn-outline-secondary">Limpar</a>
                            {{end}}
                            <button type="submit" class="btn btn-primary">Buscar</button>
                        </div>
                    </form>

                    {{if .Rows}}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    {{range .Attributes}}
                                    <th>{{.Label}}</th>
                                    {{end}}
                                    <th class="text-end">{{t $.Locale "Actions"}}</th>
                                </tr>
                            </thead>
                            <tbody id="records-body">
                                {{template "forms_records_rows" .}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <p class="text-muted">
                        {{if .Filter}}{{t $.Locale "No record matches"}} "{{.Filter}}".
                        {{else}}{{t $.Locale "No records yet."}} <a href="/form/{{.Form.MachineName}}">{{t $.Locale "New"}}</a>
                        {{end}}
                    </p>
                    {{end}}
                </div>
            </div>
        </div>
    </main>

    <footer>{{template "footer" .}}</footer>
    {{template "scripts" .}}
  </body>
</html>
