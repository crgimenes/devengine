<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-4 py-md-5">
        {{if .Message}}
        <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
            {{.Message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h2 class="mb-1">Registros - {{.Form.Label}}</h2>
                        <small class="text-muted">
                            Tabela: <strong>{{.EntityType.Name}}</strong>
                        </small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/forms/{{.Form.ReferenceID}}/new" class="btn btn-success">Novo Registro</a>
                        <a href="/tools/forms/{{.Form.ReferenceID}}/edit" class="btn btn-secondary">Voltar</a>
                    </div>
                </div>

                {{if .Records}}
                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                {{range .Attributes}}
                                {{if not .IsComputed}}
                                <th>{{.Label}}</th>
                                {{end}}
                                {{end}}
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .Records}}
                            <tr>
                                <td><code class="small">{{.Record.ReferenceID}}</code></td>
                                {{$values := .Values}}
                                {{range $.Attributes}}
                                {{if not .IsComputed}}
                                <td>
                                    {{$val := index $values .MachineName}}
                                    {{if $val}}
                                        {{if eq .PrimitiveKind "BOOL"}}
                                            {{if $val}}Sim{{else}}Não{{end}}
                                        {{else}}
                                            {{$val}}
                                        {{end}}
                                    {{else}}
                                        <span class="text-muted">-</span>
                                    {{end}}
                                </td>
                                {{end}}
                                {{end}}
                                <td class="text-end">
                                    <a href="/forms/{{$.Form.ReferenceID}}/r/{{.Record.ReferenceID}}" class="btn btn-sm btn-outline-primary">Editar</a>
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="alert alert-secondary">
                    <i class="bi bi-info-circle"></i> Nenhum registro encontrado.
                    <a href="/forms/{{.Form.ReferenceID}}/new">Criar o primeiro registro</a>.
                </div>
                {{end}}
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
