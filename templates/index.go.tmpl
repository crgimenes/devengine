<!doctype html>
<html lang="{{.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
              {{.Message}}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          {{end}}
          
          <div class="card home-card-offset">
            <div class="card-body text-center">
                <h1 class="card-title mb-4">{{t .Locale "Welcome to %s" .Config.SiteTitle}}</h1>
              <p class="card-text mb-4">{{t .Locale "Sign in with your account to continue."}}</p>
              <a href="/login" class="btn btn-primary btn-lg">{{t .Locale "Go to login"}}</a>
            </div>
          </div>
        </div>
      </div>
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
