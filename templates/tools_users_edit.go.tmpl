<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            {{.Message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}
        {{if .Error}}
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            {{.Error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}

        {{if .NewPassword}}
        <div class="alert alert-warning mb-4" role="alert">
            <p class="mb-2"><strong>Nova senha gerada.</strong> Copie e entregue ao usuário — ela não será mostrada novamente.</p>
            <input type="text" class="form-control" readonly value="{{.NewPassword}}" onclick="this.select()">
        </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">Editar usuário</h2>
                        <a href="/tools/users" class="btn btn-sm btn-outline-secondary">Voltar</a>
                    </div>

                    <form method="post" action="/tools/users/{{.Target.ReferenceID}}/update">
                        <div class="mb-3">
                            <label for="username" class="form-label">Usuário</label>
                            <input type="text" class="form-control" id="username" name="username"
                                   value="{{.Target.Username}}" minlength="3" maxlength="30" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email"
                                   value="{{.Target.Email}}" autocomplete="email">
                            <small class="form-text text-muted">Opcional.</small>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="sysop" name="sysop" value="1"
                                   {{if .Target.Sysop}}checked{{end}}
                                   {{if .IsSelf}}disabled{{end}}>
                            <label class="form-check-label" for="sysop">
                                Sysop
                                {{if .IsSelf}}<small class="text-muted">(não é possível alterar a própria flag)</small>{{end}}
                            </label>
                            {{if .IsSelf}}
                            <input type="hidden" name="sysop" value="{{if .Target.Sysop}}1{{else}}0{{end}}">
                            {{end}}
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="1"
                                   {{if .Target.Enabled}}checked{{end}}
                                   {{if .IsSelf}}disabled{{end}}>
                            <label class="form-check-label" for="enabled">
                                Ativo
                                {{if .IsSelf}}<small class="text-muted">(não é possível desabilitar a si mesmo)</small>{{end}}
                            </label>
                            {{if .IsSelf}}
                            <input type="hidden" name="enabled" value="{{if .Target.Enabled}}1{{else}}0{{end}}">
                            {{end}}
                        </div>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </form>
                </div>

                <div class="card p-4">
                    <h5 class="mb-3">Resetar senha</h5>
                    <p class="text-muted small mb-3">Gera uma senha aleatória, salva o hash e exibe a senha em texto plano uma única vez para você copiar e entregar ao usuário.</p>
                    <form method="post" action="/tools/users/{{.Target.ReferenceID}}/reset-password"
                          onsubmit="return confirm('Gerar nova senha para {{.Target.Username}}?');">
                        <button type="submit" class="btn btn-warning">Gerar nova senha</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer>{{template "footer" .}}</footer>
    {{template "scripts" .}}
  </body>
</html>
