<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            {{.Message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}
        {{if .Error}}
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            {{.Error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}

        {{if .NewPassword}}
        <div class="alert alert-warning mb-4" role="alert">
            <p class="mb-2"><strong>{{t $.Locale "New password generated."}}</strong> {{t $.Locale "Copy it and hand it to the user — it will not be shown again."}}</p>
            <input type="text" class="form-control" readonly value="{{.NewPassword}}" data-select-on-click>
        </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">{{t $.Locale "Edit user"}}</h2>
                        <a href="/tools/users" class="btn btn-sm btn-outline-secondary">{{t $.Locale "Back"}}</a>
                    </div>

                    <form method="post" action="/tools/users/{{.Target.ReferenceID}}/update">
                        <div class="mb-3">
                            <label for="username" class="form-label">{{t $.Locale "User"}}</label>
                            <input type="text" class="form-control" id="username" name="username"
                                   value="{{.Target.Username}}" minlength="3" maxlength="30" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email"
                                   value="{{.Target.Email}}" autocomplete="email">
                            <small class="form-text text-muted">Opcional.</small>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="sysop" name="sysop" value="1"
                                   {{if .Target.Sysop}}checked{{end}}
                                   {{if .IsSelf}}disabled{{end}}>
                            <label class="form-check-label" for="sysop">
                                Sysop
                                {{if .IsSelf}}<small class="text-muted">({{t $.Locale "you cannot change your own flag"}})</small>{{end}}
                            </label>
                            {{if .IsSelf}}
                            <input type="hidden" name="sysop" value="{{if .Target.Sysop}}1{{else}}0{{end}}">
                            {{end}}
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="1"
                                   {{if .Target.Enabled}}checked{{end}}
                                   {{if .IsSelf}}disabled{{end}}>
                            <label class="form-check-label" for="enabled">
                                {{t $.Locale "Active"}}
                                {{if .IsSelf}}<small class="text-muted">({{t $.Locale "you cannot disable yourself"}})</small>{{end}}
                            </label>
                            {{if .IsSelf}}
                            <input type="hidden" name="enabled" value="{{if .Target.Enabled}}1{{else}}0{{end}}">
                            {{end}}
                        </div>
                        <button type="submit" class="btn btn-primary">{{t $.Locale "Save"}}</button>
                    </form>
                </div>

                <div class="card p-4">
                    <h5 class="mb-3">{{t $.Locale "Reset password"}}</h5>
                    <p class="text-muted small mb-3">{{t $.Locale "Generates a random password, stores its hash and shows the plaintext once for you to copy and hand over."}}</p>
                    <form method="post" action="/tools/users/{{.Target.ReferenceID}}/reset-password"
                          data-confirm-message="{{t $.Locale "Generate a new password for %s?" .Target.Username}}">
                        <button type="submit" class="btn btn-warning">{{t $.Locale "Generate a new password"}}</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer>{{template "footer" .}}</footer>
    {{template "scripts" .}}
  </body>
</html>
