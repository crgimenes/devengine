<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

        <main class="container-fluid container-lg py-4 py-lg-5">
      <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
              <li class="breadcrumb-item active" aria-current="page">{{.Workspace.Name}} - Formulários</li>
          </ol>
      </nav>

            <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-start align-items-md-center mb-4">
                <div>
                    <h1 class="h3 mb-1">Formulários do workspace</h1>
                    <p class="text-muted mb-0">{{.Workspace.Name}}</p>
                </div>
                <div class="w-100" style="max-width: 240px;">
                    <a href="/eav/forms/create?workspace_id={{.Workspace.ID}}" class="btn btn-primary w-100">Novo Formulário</a>
                </div>
            </div>

            {{if .Forms}}
            <div class="row g-3 g-md-4">
                {{range .Forms}}
                <div class="col-12 col-md-6 col-xl-4">
                  {{ $base := printf "/eav/workspaces/%s/forms/%s" $.Workspace.ReferenceID .MachineName }}
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h2 class="h5 mb-1">{{.Label}}</h2>
                                    <p class="text-muted small mb-1">
                                        Machine name: <code>{{.MachineName}}</code>
                                    </p>
                                    <div class="text-muted small">Criado em {{.CreatedAt.Format "02/01/2006 15:04"}}</div>
                                </div>
                                <span class="badge {{if .Active}}text-bg-success{{else}}text-bg-secondary{{end}}">{{if .Active}}Ativo{{else}}Inativo{{end}}</span>
                            </div>

                            <div class="d-flex flex-column gap-2 mt-auto">
                                <a href="/eav/forms/edit?id={{.ID}}" class="btn btn-outline-light w-100">Editar formulário</a>
                                <a href="{{$base}}/records" class="btn btn-outline-light w-100">Ver registros</a>
                            </div>
                        </div>
                    </article>
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="card border-0 bg-body-secondary bg-opacity-25">
                <div class="card-body text-center py-5">
                    <p class="text-muted mb-3">Nenhum formulário encontrado para este workspace.</p>
                    <a href="/eav/forms/create?workspace_id={{.Workspace.ID}}" class="btn btn-primary">Criar primeiro formulário</a>
                </div>
            </div>
            {{end}}
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
