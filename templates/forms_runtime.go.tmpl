<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-3">
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <strong>Error:</strong> {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .PosLoadError}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                <strong>Warning:</strong> {{.PosLoadError}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-12">
                <div class="p-3">
                    {{if not .Form.HideTitle}}
                    <h2 class="mb-3">
                        {{.Form.Label}}
                        {{if .Form.EAVEntityTypeID}}
                            {{if .Record}}
                                <small class="text-muted"> - Edit</small>
                            {{else}}
                                <small class="text-muted"> - New</small>
                            {{end}}
                        {{end}}
                    </h2>
                    
                    {{if .Form.Description}}
                    <p class="text-muted mb-4">{{.Form.Description}}</p>
                    {{end}}
                    {{end}}
                    
                    <form method="POST"
                          action="{{if .Record}}/form/{{.Form.MachineName}}/r/{{.Record.ReferenceID}}{{else}}/form/{{.Form.MachineName}}{{end}}"
                          data-form-machine="{{.Form.MachineName}}"
                          class="needs-validation"
                          novalidate>
                        
                        {{if .Record}}
                            <input type="hidden" name="rev" value="{{.Record.Rev}}">
                            <input type="hidden" name="record_ref_id" value="{{.Record.ReferenceID}}">
                            
                            {{if .Form.ShowSystemInfo}}
                            <div class="mb-3">
                                <span class="badge bg-secondary font-monospace">{{.Record.ReferenceID}}</span>
                                {{if eq .Record.Status "active"}}
                                    <span class="badge bg-success">Active</span>
                                {{else}}
                                    <span class="badge bg-warning">Draft</span>
                                {{end}}
                            </div>
                            {{end}}
                        {{end}}

                        {{/* Render hierarchical elements using ElementsTree */}}
                        {{$recordRef := ""}}
                        {{if .Record}}{{$recordRef = .Record.ReferenceID}}{{end}}
                        <div class="row">
                            {{range .ElementsTree}}
                                {{template "render_element" (dict "Node" . "Values" $.Values "Depth" 0 "Form" $.Form "RecordRefID" $recordRef "Locale" $.Locale)}}
                            {{end}}
                        </div>

                        {{/* Show buttons only if form has EAV entity linked and buttons are not hidden */}}
                        {{if .Form.EAVEntityTypeID}}
                        {{$showSubmit := not .Form.HideSubmitButton}}
                        {{$showCancel := not .Form.HideCancelButton}}
                        {{if or $showSubmit $showCancel}}
                        <hr>
                        <div class="d-flex gap-2">
                            {{if $showSubmit}}
                            <button type="submit" class="btn btn-primary">
                                {{if .Record}}{{t $.Locale "Save changes"}}{{else}}{{t $.Locale "Create record"}}{{end}}
                            </button>
                            {{end}}
                            {{if $showCancel}}
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                            {{end}}
                        </div>
                        {{end}}
                        {{end}}
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    
    {{/* Load button actions JavaScript as external files for CSP compliance */}}
    {{$hasButtons := false}}
    {{range .ElementsTree}}{{if eq .Element.ElementKind "button"}}{{$hasButtons = true}}{{end}}{{end}}
    {{if $hasButtons}}
    <script src="/form/{{.Form.MachineName}}/actions.js"></script>
    <script src="/assets/form-buttons.js"></script>
    {{end}}

    {{/* Computed fields preview — recomputes is_computed attrs as the user types */}}
    <script src="/assets/form-preview.js"></script>
    
    {{/* Image field support - include filemanager modal and picker script */}}
    {{$hasImages := false}}
    {{range .ElementsTree}}{{if eq .Element.UIKind "image"}}{{$hasImages = true}}{{end}}{{end}}
    {{if $hasImages}}
    {{template "filemanager_modal" .}}
    <script src="/assets/field-image-picker.js"></script>
    {{end}}
    
    {{/* Video field support - include filemanager modal and picker script */}}
    {{$hasVideos := false}}
    {{range .ElementsTree}}{{if eq .Element.UIKind "video"}}{{$hasVideos = true}}{{end}}{{end}}
    {{if $hasVideos}}
    {{if not $hasImages}}{{template "filemanager_modal" .}}{{end}}
    <script src="/assets/field-video-picker.js"></script>
    {{end}}
    
    {{/* Audio field support */}}
    {{$hasAudios := false}}
    {{range .ElementsTree}}{{if eq .Element.UIKind "audio"}}{{$hasAudios = true}}{{end}}{{end}}
    {{if $hasAudios}}
    {{if and (not $hasImages) (not $hasVideos)}}{{template "filemanager_modal" .}}{{end}}
    <script src="/assets/field-audio-picker.js"></script>
    {{end}}
  </body>
</html>

{{/* Template for rendering a single element node with its children */}}
{{define "render_element"}}
    {{$node := .Node}}
    {{$values := .Values}}
    {{$depth := .Depth}}
    {{$form := .Form}}
    {{$recordRef := .RecordRefID}}
    
    {{if eq $node.Element.ElementKind "divider"}}
        <div class="col-12"><hr class="my-4"></div>
    
    {{else if eq $node.Element.ElementKind "group"}}
        {{template "group_fieldset" (dict "Node" $node "Values" $values "Depth" $depth "Form" $form "RecordRefID" $recordRef "Meta" (parseGroupMeta $node.Element.UIMetaJSON "group") "Locale" $.Locale)}}
    
    {{else if eq $node.Element.ElementKind "accordion"}}
        {{template "group_accordion" (dict "Node" $node "Values" $values "Depth" $depth "Form" $form "RecordRefID" $recordRef "Meta" (parseGroupMeta $node.Element.UIMetaJSON "accordion") "Locale" $.Locale)}}
    
    {{else if eq $node.Element.ElementKind "card"}}
        {{template "group_card" (dict "Node" $node "Values" $values "Depth" $depth "Form" $form "RecordRefID" $recordRef "Meta" (parseGroupMeta $node.Element.UIMetaJSON "card") "Locale" $.Locale)}}
    
    {{else if eq $node.Element.ElementKind "tabs"}}
        {{template "group_tabs" (dict "Node" $node "Values" $values "Depth" $depth "Form" $form "RecordRefID" $recordRef "Meta" (parseGroupMeta $node.Element.UIMetaJSON "tabs") "Locale" $.Locale)}}
    
    {{else if eq $node.Element.ElementKind "carousel"}}
        {{template "group_carousel" (dict "Node" $node "Values" $values "Depth" $depth "Form" $form "RecordRefID" $recordRef "Meta" (parseGroupMeta $node.Element.UIMetaJSON "carousel") "Locale" $.Locale)}}
    
    {{else if eq $node.Element.ElementKind "button"}}
        {{/* Button element */}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3{{if eq $node.Element.Alignment "center"}} mx-auto{{else if eq $node.Element.Alignment "right"}} ms-auto{{end}}">
            {{template "field_button" (dict "Element" $node.Element "FormMachineName" $form.MachineName "Locale" $.Locale)}}
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{end}}
        </div>
    
    {{else if $node.Attribute}}
        {{/* Field bound to EAV attribute */}}
        {{$value := index $values $node.Attribute.MachineName}}
        {{$uiKind := $node.Element.UIKind}}
        {{/* Determine ui_kind from PrimitiveKind if not explicitly set */}}
        {{if not $uiKind}}
            {{if eq $node.Attribute.PrimitiveKind "BOOL"}}{{$uiKind = "bool"}}
            {{else if eq $node.Attribute.PrimitiveKind "INT"}}{{$uiKind = "int"}}
            {{else if eq $node.Attribute.PrimitiveKind "REAL"}}{{$uiKind = "decimal"}}
            {{else if eq $node.Attribute.PrimitiveKind "DATETIME"}}{{$uiKind = "datetime"}}
            {{else}}{{$uiKind = "text"}}{{end}}
        {{end}}
        {{$meta := parseFieldMeta $node.Element.UIMetaJSON $uiKind}}
        
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3{{if eq $node.Element.Alignment "center"}} mx-auto{{else if eq $node.Element.Alignment "right"}} ms-auto{{end}}">
            {{if not $node.Element.HideLabel}}
            <label for="{{$node.Element.MachineName}}" class="form-label">
                {{if $node.Element.Label}}{{$node.Element.Label}}{{else}}{{$node.Attribute.Label}}{{end}}
                {{if $node.Attribute.IsRequired}}<span class="text-danger">*</span>{{end}}
            </label>
            {{end}}
            
            {{renderField (printf "field_%s" $uiKind) (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly "RecordRefID" $recordRef "FormMachineName" $form.MachineName "Locale" $.Locale)}}

            {{with $node.FieldError}}
                <div class="text-danger small mt-1">{{.}}</div>
            {{end}}

            {{if not $node.Element.HideHelpText}}
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{else if $node.Attribute.HelpText}}
                <div class="form-text">{{$node.Attribute.HelpText}}</div>
            {{end}}
            {{end}}
        </div>
    
    {{else}}
        {{/* UI-only field without EAV binding */}}
        {{$uiKind := $node.Element.UIKind}}
        {{if not $uiKind}}{{$uiKind = "text"}}{{end}}
        {{$meta := parseFieldMeta $node.Element.UIMetaJSON $uiKind}}
        
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3{{if eq $node.Element.Alignment "center"}} mx-auto{{else if eq $node.Element.Alignment "right"}} ms-auto{{end}}">
            {{if not $node.Element.HideLabel}}
            <label for="{{$node.Element.MachineName}}" class="form-label">
                {{$node.Element.Label}}
            </label>
            {{end}}
            
            {{renderField (printf "field_%s" $uiKind) (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly "RecordRefID" $recordRef "FormMachineName" $form.MachineName "Locale" $.Locale)}}
            
            {{if not $node.Element.HideHelpText}}
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{end}}
            {{end}}
        </div>
    {{end}}
{{end}}
