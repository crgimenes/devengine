<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .PosLoadError}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                <strong>Aviso:</strong> {{.PosLoadError}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-4">
                    <h2 class="mb-3">
                        {{.Form.Label}}
                        {{if .Record}}
                            <small class="text-muted"> - Editar</small>
                        {{else}}
                            <small class="text-muted"> - Novo</small>
                        {{end}}
                    </h2>
                    
                    {{if .Form.Description}}
                    <p class="text-muted mb-4">{{.Form.Description}}</p>
                    {{end}}
                    
                    <form method="POST" 
                          action="{{if .Record}}/forms/{{.Form.ReferenceID}}/r/{{.Record.ReferenceID}}{{else}}/forms/{{.Form.ReferenceID}}/new{{end}}"
                          class="needs-validation"
                          novalidate>
                        
                        {{if .Record}}
                            <input type="hidden" name="rev" value="{{.Record.Rev}}">
                            <div class="mb-3">
                                <span class="badge bg-secondary font-monospace">{{.Record.ReferenceID}}</span>
                                {{if eq .Record.Status "active"}}
                                    <span class="badge bg-success">Ativo</span>
                                {{else}}
                                    <span class="badge bg-warning">Rascunho</span>
                                {{end}}
                            </div>
                        {{end}}

                        {{/* Render hierarchical elements using ElementsTree */}}
                        <div class="row">
                            {{range .ElementsTree}}
                                {{template "render_element" (dict "Node" . "Values" $.Values "Depth" 0)}}
                            {{end}}
                        </div>

                        <hr>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                {{if .Record}}Salvar Alterações{{else}}Criar Registro{{end}}
                            </button>
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>

{{/* Template for rendering a single element node with its children */}}
{{define "render_element"}}
    {{$node := .Node}}
    {{$values := .Values}}
    {{$depth := .Depth}}
    
    {{if eq $node.Element.ElementKind "divider"}}
        <div class="col-12"><hr class="my-4"></div>
    
    {{else if eq $node.Element.ElementKind "group"}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}}">
            <fieldset class="border rounded p-3 mb-3">
                <legend class="h6">{{$node.Element.Label}}</legend>
                {{if $node.Element.HelpText}}<small class="text-muted d-block mb-2">{{$node.Element.HelpText}}</small>{{end}}
                {{/* Render children inside the group */}}
                <div class="row">
                    {{range $node.Children}}
                        {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 1))}}
                    {{end}}
                </div>
            </fieldset>
        </div>
    
    {{else if eq $node.Element.ElementKind "accordion"}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}}">
            <div class="accordion mb-3" id="accordion_{{$node.Element.MachineName}}">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" 
                                data-bs-target="#collapse_{{$node.Element.MachineName}}" aria-expanded="true">
                            {{$node.Element.Label}}
                        </button>
                    </h2>
                    <div id="collapse_{{$node.Element.MachineName}}" class="accordion-collapse collapse show">
                        <div class="accordion-body">
                            {{if $node.Element.HelpText}}<p class="text-muted">{{$node.Element.HelpText}}</p>{{end}}
                            {{/* Render children inside accordion */}}
                            <div class="row">
                                {{range $node.Children}}
                                    {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 1))}}
                                {{end}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
    {{else if eq $node.Element.ElementKind "card"}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}}">
            <div class="card mb-3">
                {{if $node.Element.Label}}
                <div class="card-header">{{$node.Element.Label}}</div>
                {{end}}
                <div class="card-body">
                    {{if $node.Element.HelpText}}<p class="card-text text-muted">{{$node.Element.HelpText}}</p>{{end}}
                    {{/* Render children inside card */}}
                    <div class="row">
                        {{range $node.Children}}
                            {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 1))}}
                        {{end}}
                    </div>
                </div>
            </div>
        </div>
    
    {{else if $node.Attribute}}
        {{/* Field bound to EAV attribute */}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3">
            <label for="field_{{$node.Element.MachineName}}" class="form-label">
                {{if $node.Element.Label}}{{$node.Element.Label}}{{else}}{{$node.Attribute.Label}}{{end}}
                {{if $node.Attribute.IsRequired}}<span class="text-danger">*</span>{{end}}
            </label>
            
            {{$value := index $values $node.Attribute.MachineName}}
            
            {{if eq $node.Attribute.PrimitiveKind "BOOL"}}
                <select class="form-select" 
                        id="field_{{$node.Element.MachineName}}" 
                        name="field_{{$node.Element.MachineName}}"
                        {{if $node.Attribute.IsRequired}}required{{end}}>
                    <option value="">Selecione...</option>
                    <option value="true" {{if eq $value true}}selected{{end}}>Sim</option>
                    <option value="false" {{if eq $value false}}selected{{end}}>Não</option>
                </select>
            {{else if eq $node.Attribute.PrimitiveKind "INT"}}
                <input type="number" 
                       class="form-control" 
                       id="field_{{$node.Element.MachineName}}" 
                       name="field_{{$node.Element.MachineName}}"
                       value="{{$value}}"
                       {{if $node.Attribute.IsRequired}}required{{end}}>
            {{else if eq $node.Attribute.PrimitiveKind "REAL"}}
                <input type="number" 
                       step="any"
                       class="form-control" 
                       id="field_{{$node.Element.MachineName}}" 
                       name="field_{{$node.Element.MachineName}}"
                       value="{{$value}}"
                       {{if $node.Attribute.IsRequired}}required{{end}}>
            {{else if eq $node.Attribute.PrimitiveKind "DATETIME"}}
                <input type="datetime-local" 
                       class="form-control" 
                       id="field_{{$node.Element.MachineName}}" 
                       name="field_{{$node.Element.MachineName}}"
                       value="{{$value}}"
                       {{if $node.Attribute.IsRequired}}required{{end}}>
            {{else}}
                {{/* TEXT and others - use text input */}}
                <input type="text" 
                       class="form-control" 
                       id="field_{{$node.Element.MachineName}}" 
                       name="field_{{$node.Element.MachineName}}"
                       value="{{$value}}"
                       {{if $node.Attribute.MaxLength}}maxlength="{{$node.Attribute.MaxLength}}"{{end}}
                       {{if $node.Attribute.IsRequired}}required{{end}}>
            {{end}}
            
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{else if $node.Attribute.HelpText}}
                <div class="form-text">{{$node.Attribute.HelpText}}</div>
            {{end}}
        </div>
    
    {{else}}
        {{/* UI-only field without EAV binding */}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3">
            <label class="form-label">{{$node.Element.Label}}</label>
            <input type="text" class="form-control" disabled placeholder="Campo UI apenas">
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{end}}
        </div>
    {{end}}
{{end}}
