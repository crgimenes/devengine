<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .PosLoadError}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                <strong>Aviso:</strong> {{.PosLoadError}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-12">
                <div class="card p-4">
                    <h2 class="mb-3">
                        {{.Form.Label}}
                        {{if .Record}}
                            <small class="text-muted"> - Editar</small>
                        {{else}}
                            <small class="text-muted"> - Novo</small>
                        {{end}}
                    </h2>
                    
                    {{if .Form.Description}}
                    <p class="text-muted mb-4">{{.Form.Description}}</p>
                    {{end}}
                    
                    <form method="POST" 
                          action="{{if .Record}}/forms/{{.Form.ReferenceID}}/r/{{.Record.ReferenceID}}{{else}}/forms/{{.Form.ReferenceID}}/new{{end}}"
                          class="needs-validation"
                          novalidate>
                        
                        {{if .Record}}
                            <input type="hidden" name="rev" value="{{.Record.Rev}}">
                            <div class="mb-3">
                                <span class="badge bg-secondary font-monospace">{{.Record.ReferenceID}}</span>
                                {{if eq .Record.Status "active"}}
                                    <span class="badge bg-success">Ativo</span>
                                {{else}}
                                    <span class="badge bg-warning">Rascunho</span>
                                {{end}}
                            </div>
                        {{end}}

                        {{/* Render hierarchical elements using ElementsTree */}}
                        <div class="row">
                            {{range .ElementsTree}}
                                {{template "render_element" (dict "Node" . "Values" $.Values "Depth" 0)}}
                            {{end}}
                        </div>

                        {{/* Show buttons only if form has EAV entity linked and buttons are not hidden */}}
                        {{if .Form.EAVEntityTypeID}}
                        {{$showSubmit := not .Form.HideSubmitButton}}
                        {{$showCancel := not .Form.HideCancelButton}}
                        {{if or $showSubmit $showCancel}}
                        <hr>
                        <div class="d-flex gap-2">
                            {{if $showSubmit}}
                            <button type="submit" class="btn btn-primary">
                                {{if .Record}}Salvar Alterações{{else}}Criar Registro{{end}}
                            </button>
                            {{end}}
                            {{if $showCancel}}
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records" class="btn btn-secondary">Cancelar</a>
                            {{end}}
                        </div>
                        {{end}}
                        {{end}}
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    
    {{/* Generate JavaScript handlers for button elements */}}
    {{$hasButtons := false}}
    {{range .ElementsTree}}{{if eq .Element.ElementKind "button"}}{{$hasButtons = true}}{{end}}{{end}}
    {{if $hasButtons}}
    <script>
    (function() {
        const FormButtonActions = {
            {{range .ElementsTree}}
            {{if eq .Element.ElementKind "button"}}
            {{if .Element.ButtonJSCode}}
            '{{.Element.MachineName}}': function(formData, button) {
                {{.Element.ButtonJSCode}}
            },
            {{end}}
            {{end}}
            {{end}}
        };

        document.querySelectorAll('[data-form-action]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const actionName = this.dataset.formAction;
                const hasServerAction = this.dataset.hasServerAction === 'true';
                const confirmMsg = this.dataset.confirmMessage;
                const actionUrl = this.dataset.actionUrl;
                
                if (confirmMsg && !confirm(confirmMsg)) return;
                
                const form = this.closest('form');
                const formData = new FormData(form);
                
                // Run client JS first (if exists)
                if (FormButtonActions[actionName]) {
                    const result = FormButtonActions[actionName](formData, this);
                    if (result === false) return; // abort if returns false
                }
                
                // Then POST to server (if has server action)
                if (hasServerAction && actionUrl) {
                    this.disabled = true;
                    const originalContent = this.innerHTML;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> ...';
                    
                    fetch(actionUrl, {
                        method: 'POST',
                        body: formData
                    })
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data.error) {
                            alert(data.error);
                        } else if (data.message) {
                            alert(data.message);
                        }
                        if (data.redirect_to) {
                            window.location.href = data.redirect_to;
                        } else {
                            window.location.reload();
                        }
                    })
                    .catch(function(err) {
                        alert('Erro: ' + err.message);
                        btn.disabled = false;
                        btn.innerHTML = originalContent;
                    });
                }
            });
        });
    })();
    </script>
    {{end}}
  </body>
</html>

{{/* Template for rendering a single element node with its children */}}
{{define "render_element"}}
    {{$node := .Node}}
    {{$values := .Values}}
    {{$depth := .Depth}}
    
    {{if eq $node.Element.ElementKind "divider"}}
        <div class="col-12"><hr class="my-4"></div>
    
    {{else if eq $node.Element.ElementKind "group"}}
        {{template "group_fieldset" (dict "Node" $node "Values" $values "Depth" $depth "Meta" (parseGroupMeta $node.Element.UIMetaJSON "group"))}}
    
    {{else if eq $node.Element.ElementKind "accordion"}}
        {{template "group_accordion" (dict "Node" $node "Values" $values "Depth" $depth "Meta" (parseGroupMeta $node.Element.UIMetaJSON "accordion"))}}
    
    {{else if eq $node.Element.ElementKind "card"}}
        {{template "group_card" (dict "Node" $node "Values" $values "Depth" $depth "Meta" (parseGroupMeta $node.Element.UIMetaJSON "card"))}}
    
    {{else if eq $node.Element.ElementKind "tabs"}}
        {{template "group_tabs" (dict "Node" $node "Values" $values "Depth" $depth "Meta" (parseGroupMeta $node.Element.UIMetaJSON "tabs"))}}
    
    {{else if eq $node.Element.ElementKind "carousel"}}
        {{template "group_carousel" (dict "Node" $node "Values" $values "Depth" $depth "Meta" (parseGroupMeta $node.Element.UIMetaJSON "carousel"))}}
    
    {{else if eq $node.Element.ElementKind "button"}}
        {{/* Button element */}}
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3">
            {{template "field_button" (dict "Element" $node.Element "FormRef" $.Form.ReferenceID)}}
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{end}}
        </div>
    
    {{else if $node.Attribute}}
        {{/* Field bound to EAV attribute */}}
        {{$value := index $values $node.Attribute.MachineName}}
        {{$uiKind := $node.Element.UIKind}}
        {{/* Determine ui_kind from PrimitiveKind if not explicitly set */}}
        {{if not $uiKind}}
            {{if eq $node.Attribute.PrimitiveKind "BOOL"}}{{$uiKind = "bool"}}
            {{else if eq $node.Attribute.PrimitiveKind "INT"}}{{$uiKind = "int"}}
            {{else if eq $node.Attribute.PrimitiveKind "REAL"}}{{$uiKind = "decimal"}}
            {{else if eq $node.Attribute.PrimitiveKind "DATETIME"}}{{$uiKind = "datetime"}}
            {{else}}{{$uiKind = "text"}}{{end}}
        {{end}}
        {{$meta := parseFieldMeta $node.Element.UIMetaJSON $uiKind}}
        
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3">
            <label for="{{$node.Element.MachineName}}" class="form-label">
                {{if $node.Element.Label}}{{$node.Element.Label}}{{else}}{{$node.Attribute.Label}}{{end}}
                {{if $node.Attribute.IsRequired}}<span class="text-danger">*</span>{{end}}
            </label>
            
            {{if eq $uiKind "bool"}}
                {{template "field_bool" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "int"}}
                {{template "field_int" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "decimal"}}
                {{template "field_decimal" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "datetime"}}
                {{template "field_datetime" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "textarea"}}
                {{template "field_textarea" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "select"}}
                {{template "field_select" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{else}}
                {{/* Default: text */}}
                {{template "field_text" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" $value "Required" $node.Attribute.IsRequired "Readonly" $node.Element.IsReadonly)}}
            {{end}}
            
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{else if $node.Attribute.HelpText}}
                <div class="form-text">{{$node.Attribute.HelpText}}</div>
            {{end}}
        </div>
    
    {{else}}
        {{/* UI-only field without EAV binding */}}
        {{$uiKind := $node.Element.UIKind}}
        {{if not $uiKind}}{{$uiKind = "text"}}{{end}}
        {{$meta := parseFieldMeta $node.Element.UIMetaJSON $uiKind}}
        
        <div class="col-12 col-md-{{$node.Element.ColSpan}} mb-3">
            <label for="{{$node.Element.MachineName}}" class="form-label">
                {{$node.Element.Label}}
            </label>
            
            {{if eq $uiKind "bool"}}
                {{template "field_bool" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "int"}}
                {{template "field_int" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "decimal"}}
                {{template "field_decimal" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "datetime"}}
                {{template "field_datetime" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "textarea"}}
                {{template "field_textarea" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else if eq $uiKind "select"}}
                {{template "field_select" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{else}}
                {{template "field_text" (dict "Meta" $meta "Name" $node.Element.MachineName "Value" nil "Required" false "Readonly" $node.Element.IsReadonly)}}
            {{end}}
            
            {{if $node.Element.HelpText}}
                <div class="form-text">{{$node.Element.HelpText}}</div>
            {{end}}
        </div>
    {{end}}
{{end}}
