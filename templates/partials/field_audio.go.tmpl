{{define "field_audio"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}

<div class="field-audio-container" data-audio-options="{{$meta}}">
    {{/* Preview area */}}
    <div class="field-audio-preview-wrapper mb-2" id="{{$name}}_preview_wrapper">
        {{if $value}}
        <audio src="{{$value}}" 
               {{if index $meta "controls"}}controls{{end}}
               {{if index $meta "autoplay"}}autoplay{{end}}
               {{if index $meta "loop"}}loop{{end}}
               {{if index $meta "muted"}}muted{{end}}
               class="field-audio-preview w-100" 
               id="{{$name}}_preview"></audio>
        {{else}}
        <div class="field-audio-placeholder text-center text-muted p-4 border rounded bg-body-secondary {{if not $readonly}}cursor-pointer{{end}}"
             {{if not $readonly}}
             role="button"
             data-bs-toggle="modal"
             data-bs-target="#fileManagerModal"
             data-field-name="{{$name}}"
             title="{{t .Locale "Click to pick an audio file"}}"
             {{end}}>
            <svg class="mb-2" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                <path d="M6 13c0 1.105-1.12 2-2.5 2S1 14.105 1 13c0-1.104 1.12-2 2.5-2s2.5.896 2.5 2zm9-2c0 1.105-1.12 2-2.5 2s-2.5-.895-2.5-2 1.12-2 2.5-2 2.5.895 2.5 2z"/>
                <path fill-rule="evenodd" d="M14 11V2h1v9h-1zM6 3v10H5V3h1z"/>
                <path d="M5 2.905a1 1 0 0 1 .9-.995l8-.8a1 1 0 0 1 1.1.995V3L5 4V2.905z"/>
            </svg>
            <div class="small">{{t .Locale "No audio selected"}}</div>
        </div>
        {{end}}
    </div>

    {{/* Hidden input to store URL */}}
    <input type="hidden" id="{{$name}}" name="{{$name}}" value="{{$value}}" 
           class="field-audio-input" {{if $required}}required{{end}}>

    {{/* Buttons - only show if not readonly */}}
    {{if not $readonly}}
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm field-audio-select-btn"
                data-field-name="{{$name}}" data-bs-toggle="modal" data-bs-target="#fileManagerModal">
            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M6 13c0 1.105-1.12 2-2.5 2S1 14.105 1 13c0-1.104 1.12-2 2.5-2s2.5.896 2.5 2zm9-2c0 1.105-1.12 2-2.5 2s-2.5-.895-2.5-2 1.12-2 2.5-2 2.5.895 2.5 2z"/>
                <path fill-rule="evenodd" d="M14 11V2h1v9h-1zM6 3v10H5V3h1z"/>
                <path d="M5 2.905a1 1 0 0 1 .9-.995l8-.8a1 1 0 0 1 1.1.995V3L5 4V2.905z"/>
            </svg>
            {{t .Locale "Pick audio"}}
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm field-audio-remove-btn {{if not $value}}d-none{{end}}"
                data-field-name="{{$name}}">
            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
            </svg>
            Remove
        </button>
    </div>
    {{end}}
</div>
{{end}}
