{{define "scripts"}}
<script defer src="/assets/bootstrap/js/bootstrap.bundle.min.js?v={{ .Config.GitTag }}"></script>
<script defer src="/assets/mobile-menu.js?v={{ .Config.GitTag }}"></script>
<script defer src="/assets/menu-actions.js?v={{ .Config.GitTag }}"></script>
{{$menuName := getMenuMachineName .}}
{{if $menuName}}
<script defer src="/menu/{{$menuName}}/actions.js?v={{ .Config.GitTag }}"></script>
{{end}}

{{/* Load SSE client only for authenticated and enabled users to avoid unnecessary connections */}}
{{ if and .Authed .User.Enabled }}
<script defer src="/assets/events.js?v={{ .Config.GitTag }}"></script>
{{ end }}

{{end}}

