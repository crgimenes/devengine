{{define "eav_records_list"}}
{{if .Records}}
<div class="table-responsive records-list-view">
    <table class="table table-striped table-hover align-middle">
        <thead class="sticky-top">
            <tr>
                <th scope="col" class="text-nowrap" style="width: 5%;">ID</th>
                {{range .VisibleFields}}
                <th scope="col" {{if .ListCols}}style="width: {{if eq .ListCols 1}}8%{{else if eq .ListCols 2}}16%{{else if eq .ListCols 3}}25%{{else if eq .ListCols 4}}33%{{else if eq .ListCols 5}}41%{{else if eq .ListCols 6}}50%{{else if eq .ListCols 7}}58%{{else if eq .ListCols 8}}66%{{else if eq .ListCols 9}}75%{{else if eq .ListCols 10}}83%{{else if eq .ListCols 11}}91%{{else}}auto{{end}};"{{end}}>{{.Label}}</th>
                {{end}}
                <th scope="col" class="text-end text-nowrap" style="width: 5%;">Ações</th>
            </tr>
        </thead>
        <tbody>
            {{range $recIdx, $recWithVals := $.Records}}
            <tr class="clickable-record" data-record-url="{{$.BasePath}}/records/{{$recWithVals.Record.ReferenceID}}">
                <td><code>{{$recWithVals.Record.ID}}</code></td>
                {{range $.VisibleFields}}
                <td>
                    {{$fieldVal := index $recWithVals.Values .ID}}
                    {{if eq .UIKind "image"}}
                        {{if $fieldVal.ValueText}}
                            <img src="{{$fieldVal.ValueText}}" alt="{{.Label}}" class="img-fluid rounded">
                        {{else}}
                            <span class="text-muted small">Sem imagem</span>
                        {{end}}
                    {{else if eq .PrimitiveKind "TEXT"}}
                        {{if $fieldVal.ValueText}}{{$fieldVal.ValueText}}{{else}}—{{end}}
                    {{else if eq .PrimitiveKind "INT"}}
                        {{if $fieldVal.ValueInt}}{{$fieldVal.ValueInt}}{{else}}—{{end}}
                    {{else if eq .PrimitiveKind "FLOAT"}}
                        {{if $fieldVal.ValueFloat}}{{printf "%.2f" $fieldVal.ValueFloat}}{{else}}—{{end}}
                    {{else if eq .PrimitiveKind "DATETIME"}}
                        {{if $fieldVal.ValueDatetime}}{{$fieldVal.ValueDatetime.Format "02/01/2006 15:04"}}{{else}}—{{end}}
                    {{else if eq .PrimitiveKind "BOOL"}}
                        {{if $fieldVal.ValueBool}}
                            <span class="badge text-bg-success">Sim</span>
                        {{else}}
                            <span class="badge text-bg-secondary">Não</span>
                        {{end}}
                    {{else}}
                        —
                    {{end}}
                </td>
                {{end}}
                <td class="text-end">
                    <a href="{{$.BasePath}}/records/{{$recWithVals.Record.ReferenceID}}" class="btn btn-sm btn-outline-light" onclick="event.stopPropagation();">
                        Ver
                    </a>
                </td>
            </tr>
            {{end}}
        </tbody>
    </table>
</div>
{{else}}
<div class="card border-0 bg-body-secondary bg-opacity-25">
    <div class="card-body text-center py-5">
        <p class="text-muted mb-3">Nenhum registro disponível.</p>
        <a href="{{$.BasePath}}/records/new" class="btn btn-primary">Criar primeiro registro</a>
    </div>
</div>
{{end}}
{{end}}
