{{define "plugin_options_panel"}}
{{/* Panel for plugin-specific options. Requires JS to show/hide based on element_kind */}}
{{$meta := .Meta}}
{{$kind := .ElementKind}}

<div id="plugin-options-container" class="mb-4">
    <!-- Group (fieldset) options -->
    <div id="options-group" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Group options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_show_legend" 
                   data-key="show_legend" {{if index $meta "show_legend"}}checked{{end}}>
            <label class="form-check-label" for="opt_show_legend">
                {{t .Locale "Show title (legend)"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_hide_border" 
                   data-key="hide_border" {{if index $meta "hide_border"}}checked{{end}}>
            <label class="form-check-label" for="opt_hide_border">
                Esconder borda
            </label>
        </div>
    </div>

    <!-- Accordion options -->
    <div id="options-accordion" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Accordion options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_expanded_by_default" 
                   data-key="expanded_by_default" {{if index $meta "expanded_by_default"}}checked{{end}}>
            <label class="form-check-label" for="opt_expanded_by_default">
                {{t .Locale "Expanded by default"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_show_header" 
                   data-key="show_header" {{if index $meta "show_header"}}checked{{end}}>
            <label class="form-check-label" for="opt_show_header">
                {{t .Locale "Show header"}}
            </label>
        </div>
    </div>

    <!-- Card options -->
    <div id="options-card" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Card options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_card_show_header" 
                   data-key="show_header" {{if index $meta "show_header"}}checked{{end}}>
            <label class="form-check-label" for="opt_card_show_header">
                {{t .Locale "Show header"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_card_hide_border" 
                   data-key="hide_border" {{if index $meta "hide_border"}}checked{{end}}>
            <label class="form-check-label" for="opt_card_hide_border">
                Esconder borda
            </label>
        </div>
        <div class="mb-3">
            <label for="opt_header_bg" class="form-label">{{t .Locale "Header background color"}}</label>
            <select class="form-select form-select-sm plugin-option" id="opt_header_bg" data-key="header_bg">
                <option value="default" {{if eq (index $meta "header_bg") "default"}}selected{{end}}>{{t .Locale "Default"}}</option>
                <option value="primary" {{if eq (index $meta "header_bg") "primary"}}selected{{end}}>{{t .Locale "Primary"}}</option>
                <option value="dark" {{if eq (index $meta "header_bg") "dark"}}selected{{end}}>Escura</option>
            </select>
        </div>
    </div>

    <!-- Tabs options -->
    <div id="options-tabs" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Tabs options"}}</h6>
        <div class="mb-3">
            <label for="opt_active_tab" class="form-label">{{t .Locale "Active tab by default (index, starts at 0)"}}</label>
            <input type="number" class="form-control form-control-sm plugin-option" id="opt_active_tab" 
                   data-key="active_tab" value="{{index $meta "active_tab"}}" min="0">
        </div>
    </div>

    <!-- Carousel options -->
    <div id="options-carousel" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Carousel options"}}</h6>
        <div class="row">
            <div class="col-md-6">
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_show_controls" 
                           data-key="show_controls" {{if index $meta "show_controls"}}checked{{end}}>
                    <label class="form-check-label" for="opt_show_controls">
                        Mostrar controles (setas)
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_show_indicators" 
                           data-key="show_indicators" {{if index $meta "show_indicators"}}checked{{end}}>
                    <label class="form-check-label" for="opt_show_indicators">
                        Mostrar indicadores
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_fade" 
                           data-key="fade" {{if index $meta "fade"}}checked{{end}}>
                    <label class="form-check-label" for="opt_fade">
                        {{t .Locale "Fade transition (instead of slide)"}}
                    </label>
                </div>
            </div>
            <div class="col-md-6">
                <label for="opt_interval" class="form-label">Intervalo (ms, 0 = manual)</label>
                <input type="number" class="form-control form-control-sm plugin-option" id="opt_interval" 
                       data-key="interval" value="{{index $meta "interval"}}" min="0" step="500">
            </div>
        </div>
    </div>

    <!-- Field type options - organized by ui_kind -->
    <div id="options-field" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Field options"}}</h6>
        <p class="small text-muted">{{t .Locale "Configure options specific to the UI plugin picked above."}}</p>

        {{/* Each registered plugin may ship a field_options_<id> define in
             its own package; unknown kinds simply render nothing here. */}}
        {{$panel := .}}
        {{range uiPluginIDs}}{{renderFieldOptions . $panel}}{{end}}
        
        
        
        
        
        
        



        <!-- Image options -->
        <div id="field-options-image" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_image_alt_text" class="form-label small">{{t .Locale "Alternative text"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_image_alt_text" 
                       data-key="alt_text" value="{{index $meta "alt_text"}}" placeholder="{{t .Locale "Image description"}}">
                <div class="form-text">{{t .Locale "Text shown when the image fails to load"}}</div>
            </div>
        </div>

        <!-- Video options -->
        <div id="field-options-video" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_controls" 
                               data-key="controls" {{if ne (index $meta "controls") false}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_controls">
                            Mostrar controles
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_autoplay" 
                               data-key="autoplay" {{if index $meta "autoplay"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_autoplay">
                            Reproduzir automaticamente
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_loop" 
                               data-key="loop" {{if index $meta "loop"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_loop">
                            Repetir (loop)
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_muted" 
                               data-key="muted" {{if index $meta "muted"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_muted">
                            Silenciado
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audio options -->
        <div id="field-options-audio" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_controls" 
                               data-key="controls" {{if ne (index $meta "controls") false}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_controls">
                            Mostrar controles
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_autoplay" 
                               data-key="autoplay" {{if index $meta "autoplay"}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_autoplay">
                            Reproduzir automaticamente
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_loop" 
                               data-key="loop" {{if index $meta "loop"}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_loop">
                            Repetir (loop)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Button - options are in separate section, not in ui_meta_json -->
    <div id="options-button" class="plugin-options-panel d-none">
        <p class="text-muted small">{{t .Locale "See the button settings in the section below."}}</p>
    </div>

    <!-- Divider - no options -->
    <div id="options-divider" class="plugin-options-panel d-none">
        <p class="text-muted small">{{t .Locale "Dividers have no extra options."}}</p>
    </div>
</div>
{{end}}
