{{define "plugin_options_panel"}}
{{/* Panel for plugin-specific options. Requires JS to show/hide based on element_kind */}}
{{$meta := .Meta}}
{{$kind := .ElementKind}}

<div id="plugin-options-container" class="mb-4">
    <!-- Group (fieldset) options -->
    <div id="options-group" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Group options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_show_legend" 
                   data-key="show_legend" {{if index $meta "show_legend"}}checked{{end}}>
            <label class="form-check-label" for="opt_show_legend">
                {{t .Locale "Show title (legend)"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_hide_border" 
                   data-key="hide_border" {{if index $meta "hide_border"}}checked{{end}}>
            <label class="form-check-label" for="opt_hide_border">
                Esconder borda
            </label>
        </div>
    </div>

    <!-- Accordion options -->
    <div id="options-accordion" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Accordion options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_expanded_by_default" 
                   data-key="expanded_by_default" {{if index $meta "expanded_by_default"}}checked{{end}}>
            <label class="form-check-label" for="opt_expanded_by_default">
                {{t .Locale "Expanded by default"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_show_header" 
                   data-key="show_header" {{if index $meta "show_header"}}checked{{end}}>
            <label class="form-check-label" for="opt_show_header">
                {{t .Locale "Show header"}}
            </label>
        </div>
    </div>

    <!-- Card options -->
    <div id="options-card" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Card options"}}</h6>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_card_show_header" 
                   data-key="show_header" {{if index $meta "show_header"}}checked{{end}}>
            <label class="form-check-label" for="opt_card_show_header">
                {{t .Locale "Show header"}}
            </label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input plugin-option" type="checkbox" id="opt_card_hide_border" 
                   data-key="hide_border" {{if index $meta "hide_border"}}checked{{end}}>
            <label class="form-check-label" for="opt_card_hide_border">
                Esconder borda
            </label>
        </div>
        <div class="mb-3">
            <label for="opt_header_bg" class="form-label">{{t .Locale "Header background color"}}</label>
            <select class="form-select form-select-sm plugin-option" id="opt_header_bg" data-key="header_bg">
                <option value="default" {{if eq (index $meta "header_bg") "default"}}selected{{end}}>{{t .Locale "Default"}}</option>
                <option value="primary" {{if eq (index $meta "header_bg") "primary"}}selected{{end}}>{{t .Locale "Primary"}}</option>
                <option value="dark" {{if eq (index $meta "header_bg") "dark"}}selected{{end}}>Escura</option>
            </select>
        </div>
    </div>

    <!-- Tabs options -->
    <div id="options-tabs" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Tabs options"}}</h6>
        <div class="mb-3">
            <label for="opt_active_tab" class="form-label">{{t .Locale "Active tab by default (index, starts at 0)"}}</label>
            <input type="number" class="form-control form-control-sm plugin-option" id="opt_active_tab" 
                   data-key="active_tab" value="{{index $meta "active_tab"}}" min="0">
        </div>
    </div>

    <!-- Carousel options -->
    <div id="options-carousel" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Carousel options"}}</h6>
        <div class="row">
            <div class="col-md-6">
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_show_controls" 
                           data-key="show_controls" {{if index $meta "show_controls"}}checked{{end}}>
                    <label class="form-check-label" for="opt_show_controls">
                        Mostrar controles (setas)
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_show_indicators" 
                           data-key="show_indicators" {{if index $meta "show_indicators"}}checked{{end}}>
                    <label class="form-check-label" for="opt_show_indicators">
                        Mostrar indicadores
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input plugin-option" type="checkbox" id="opt_fade" 
                           data-key="fade" {{if index $meta "fade"}}checked{{end}}>
                    <label class="form-check-label" for="opt_fade">
                        {{t .Locale "Fade transition (instead of slide)"}}
                    </label>
                </div>
            </div>
            <div class="col-md-6">
                <label for="opt_interval" class="form-label">Intervalo (ms, 0 = manual)</label>
                <input type="number" class="form-control form-control-sm plugin-option" id="opt_interval" 
                       data-key="interval" value="{{index $meta "interval"}}" min="0" step="500">
            </div>
        </div>
    </div>

    <!-- Field type options - organized by ui_kind -->
    <div id="options-field" class="plugin-options-panel d-none">
        <h6 class="text-muted mb-3">{{t .Locale "Field options"}}</h6>
        <p class="small text-muted">{{t .Locale "Configure options specific to the UI plugin picked above."}}</p>
        
        <!-- Text field options -->
        <div id="field-options-text" class="field-ui-options">
            <div class="mb-2">
                <label for="opt_text_placeholder" class="form-label small">Placeholder</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_text_placeholder" 
                       data-key="placeholder" value="{{index $meta "placeholder"}}">
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label for="opt_text_maxLength" class="form-label small">{{t .Locale "Maximum length"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_text_maxLength" 
                           data-key="maxLength" value="{{index $meta "maxLength"}}" min="0">
                </div>
                <div class="col-md-6 mb-2">
                    <label for="opt_text_inputMode" class="form-label small">Modo de entrada</label>
                    <select class="form-select form-select-sm plugin-option" id="opt_text_inputMode" data-key="inputMode">
                        <option value="text" {{if eq (index $meta "inputMode") "text"}}selected{{end}}>Texto</option>
                        <option value="email" {{if eq (index $meta "inputMode") "email"}}selected{{end}}>Email</option>
                        <option value="tel" {{if eq (index $meta "inputMode") "tel"}}selected{{end}}>Telefone</option>
                        <option value="url" {{if eq (index $meta "inputMode") "url"}}selected{{end}}>URL</option>
                    </select>
                </div>
            </div>
        </div>
        
        <!-- Textarea options -->
        <div id="field-options-textarea" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label for="opt_textarea_rows" class="form-label small">Linhas</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_textarea_rows" 
                           data-key="rows" value="{{index $meta "rows"}}" min="1" max="20">
                </div>
                <div class="col-md-6 mb-2">
                    <label for="opt_textarea_maxLength" class="form-label small">{{t .Locale "Maximum length"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_textarea_maxLength" 
                           data-key="maxLength" value="{{index $meta "maxLength"}}" min="0">
                </div>
            </div>
            <div class="mb-2">
                <label for="opt_textarea_placeholder" class="form-label small">Placeholder</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_textarea_placeholder" 
                       data-key="placeholder" value="{{index $meta "placeholder"}}">
            </div>
        </div>
        
        <!-- Int options -->
        <div id="field-options-int" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <label for="opt_int_min" class="form-label small">{{t .Locale "Minimum"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_int_min" 
                           data-key="min" value="{{index $meta "min"}}">
                </div>
                <div class="col-md-4 mb-2">
                    <label for="opt_int_max" class="form-label small">{{t .Locale "Maximum"}}</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_int_max" 
                           data-key="max" value="{{index $meta "max"}}">
                </div>
                <div class="col-md-4 mb-2">
                    <label for="opt_int_step" class="form-label small">Passo</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_int_step" 
                           data-key="step" value="{{index $meta "step"}}" min="1">
                </div>
            </div>
        </div>
        
        <!-- Decimal options -->
        <div id="field-options-decimal" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-3 mb-2">
                    <label for="opt_decimal_min" class="form-label small">{{t .Locale "Minimum"}}</label>
                    <input type="number" step="any" class="form-control form-control-sm plugin-option" id="opt_decimal_min" 
                           data-key="min" value="{{index $meta "min"}}">
                </div>
                <div class="col-md-3 mb-2">
                    <label for="opt_decimal_max" class="form-label small">{{t .Locale "Maximum"}}</label>
                    <input type="number" step="any" class="form-control form-control-sm plugin-option" id="opt_decimal_max" 
                           data-key="max" value="{{index $meta "max"}}">
                </div>
                <div class="col-md-3 mb-2">
                    <label for="opt_decimal_step" class="form-label small">Passo</label>
                    <input type="text" class="form-control form-control-sm plugin-option" id="opt_decimal_step" 
                           data-key="step" value="{{index $meta "step"}}" placeholder="any">
                </div>
                <div class="col-md-3 mb-2">
                    <label for="opt_decimal_places" class="form-label small">Casas decimais</label>
                    <input type="number" class="form-control form-control-sm plugin-option" id="opt_decimal_places" 
                           data-key="decimalPlaces" value="{{index $meta "decimalPlaces"}}" min="0" max="10">
                </div>
            </div>
        </div>
        
        <!-- Bool options -->
        <div id="field-options-bool" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_bool_style" class="form-label small">{{t .Locale "Display style"}}</label>
                <select class="form-select form-select-sm plugin-option" id="opt_bool_style" data-key="style">
                    <option value="select" {{if eq (index $meta "style") "select"}}selected{{end}}>{{t .Locale "Dropdown (Yes/No)"}}</option>
                    <option value="checkbox" {{if eq (index $meta "style") "checkbox"}}selected{{end}}>Checkbox</option>
                    <option value="switch" {{if eq (index $meta "style") "switch"}}selected{{end}}>Switch</option>
                </select>
            </div>
        </div>
        
        <!-- Datetime options -->
        <div id="field-options-datetime" class="field-ui-options d-none">
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_datetime_includeTime" 
                       data-key="includeTime" {{if index $meta "includeTime"}}checked{{end}}>
                <label class="form-check-label" for="opt_datetime_includeTime">
                    Incluir hora
                </label>
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label for="opt_datetime_minDate" class="form-label small">{{t .Locale "Minimum date"}}</label>
                    <input type="date" class="form-control form-control-sm plugin-option" id="opt_datetime_minDate" 
                           data-key="minDate" value="{{index $meta "minDate"}}">
                </div>
                <div class="col-md-6 mb-2">
                    <label for="opt_datetime_maxDate" class="form-label small">{{t .Locale "Maximum date"}}</label>
                    <input type="date" class="form-control form-control-sm plugin-option" id="opt_datetime_maxDate" 
                           data-key="maxDate" value="{{index $meta "maxDate"}}">
                </div>
            </div>
        </div>
        
        <!-- Select options -->
        <div id="field-options-select" class="field-ui-options d-none">
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_select_allowEmpty" 
                       data-key="allowEmpty" {{if index $meta "allowEmpty"}}checked{{end}}>
                <label class="form-check-label" for="opt_select_allowEmpty">
                    {{t .Locale "Allow an empty option"}}
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_select_multiple" 
                       data-key="multiple" {{if index $meta "multiple"}}checked{{end}}>
                <label class="form-check-label" for="opt_select_multiple">
                    {{t .Locale "Multiple selection"}}
                </label>
            </div>
            <p class="small text-muted">{{t .Locale "Options are configured directly in the JSON below."}}</p>
        </div>

        <!-- Reference options -->
        <div id="field-options-reference" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_reference_entity" class="form-label small">{{t .Locale "Referenced table (machine name)"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_reference_entity"
                       data-key="entity" value="{{index $meta "entity"}}" list="entity-machine-names"
                       placeholder="{{t .Locale "e.g. customer"}}">
            </div>
            <div class="mb-2">
                <label for="opt_reference_display" class="form-label small">{{t .Locale "Display attribute (machine name)"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_reference_display"
                       data-key="display" value="{{index $meta "display"}}" list="attribute-machine-names"
                       placeholder="{{t .Locale "e.g. name"}}">
                <div class="form-text">{{t .Locale "Shown on selects and listings instead of the record id."}}</div>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input plugin-option" type="checkbox" id="opt_reference_allowEmpty"
                       data-key="allow_empty" {{if index $meta "allow_empty"}}checked{{end}}>
                <label class="form-check-label" for="opt_reference_allowEmpty">
                    {{t .Locale "Allow an empty option"}}
                </label>
            </div>
        </div>

        <!-- Subform options -->
        <div id="field-options-subform" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_subform_targetEntity" class="form-label small">{{t .Locale "Related table (machine name)"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_subform_targetEntity"
                       data-key="target_entity" value="{{index $meta "target_entity"}}" list="entity-machine-names"
                       placeholder="{{t .Locale "e.g. order_item"}}">
            </div>
            <div class="mb-2">
                <label for="opt_subform_targetAttr" class="form-label small">{{t .Locale "Attribute pointing back at this record"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_subform_targetAttr"
                       data-key="target_attr" value="{{index $meta "target_attr"}}" list="attribute-machine-names"
                       placeholder="{{t .Locale "e.g. order"}}">
            </div>
            <div class="mb-2">
                <label for="opt_subform_display" class="form-label small">{{t .Locale "Display attribute (machine name)"}}</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_subform_display"
                       data-key="display" value="{{index $meta "display"}}" list="attribute-machine-names"
                       placeholder="{{t .Locale "e.g. description"}}">
            </div>
        </div>

        <!-- Image options -->
        <div id="field-options-image" class="field-ui-options d-none">
            <div class="mb-2">
                <label for="opt_image_alt_text" class="form-label small">Texto Alternativo</label>
                <input type="text" class="form-control form-control-sm plugin-option" id="opt_image_alt_text" 
                       data-key="alt_text" value="{{index $meta "alt_text"}}" placeholder="{{t .Locale "Image description"}}">
                <div class="form-text">{{t .Locale "Text shown when the image fails to load"}}</div>
            </div>
        </div>

        <!-- Video options -->
        <div id="field-options-video" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_controls" 
                               data-key="controls" {{if ne (index $meta "controls") false}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_controls">
                            Mostrar controles
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_autoplay" 
                               data-key="autoplay" {{if index $meta "autoplay"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_autoplay">
                            Reproduzir automaticamente
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_loop" 
                               data-key="loop" {{if index $meta "loop"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_loop">
                            Repetir (loop)
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_video_muted" 
                               data-key="muted" {{if index $meta "muted"}}checked{{end}}>
                        <label class="form-check-label" for="opt_video_muted">
                            Silenciado
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audio options -->
        <div id="field-options-audio" class="field-ui-options d-none">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_controls" 
                               data-key="controls" {{if ne (index $meta "controls") false}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_controls">
                            Mostrar controles
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_autoplay" 
                               data-key="autoplay" {{if index $meta "autoplay"}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_autoplay">
                            Reproduzir automaticamente
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check mb-2">
                        <input class="form-check-input plugin-option" type="checkbox" id="opt_audio_loop" 
                               data-key="loop" {{if index $meta "loop"}}checked{{end}}>
                        <label class="form-check-label" for="opt_audio_loop">
                            Repetir (loop)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Button - options are in separate section, not in ui_meta_json -->
    <div id="options-button" class="plugin-options-panel d-none">
        <p class="text-muted small">{{t .Locale "See the button settings in the section below."}}</p>
    </div>

    <!-- Divider - no options -->
    <div id="options-divider" class="plugin-options-panel d-none">
        <p class="text-muted small">{{t .Locale "Dividers have no extra options."}}</p>
    </div>
</div>
{{end}}
