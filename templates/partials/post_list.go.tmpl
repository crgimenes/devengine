{{define "post_list"}}
{{range .Posts}}
  {{$postAuthor := index $.UserMap .OwnerUserID}}
  <div class="card mb-3">
    <div class="card-body">
      <!-- Post header with author info -->
      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
          <!-- Avatar -->
          {{if $postAuthor.AvatarURL}}
            <img src="{{$postAuthor.AvatarURL}}" alt="{{$postAuthor.Username}}" class="rounded-circle avatar-sm" width="32" height="32">
          {{else}}
            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center avatar-placeholder-sm">
              <span class="text-white fw-bold">{{first $postAuthor.Username}}</span>
            </div>
          {{end}}
          <!-- Author name and timestamp -->
          <div>
            <div class="fw-bold font-sm">{{$postAuthor.Username}}</div>
            <small class="text-body-secondary font-xs">{{.CreatedAt.Format "2006-01-02 15:04"}}</small>
          </div>
        </div>
        <!-- Action buttons (only visible to post author) -->
        {{if eq $.User.ID .OwnerUserID}}
          <div class="d-flex gap-2" role="group">
            <button type="button" class="edit-post-btn btn btn-sm btn-outline-secondary action-btn-square" data-post-id="{{.ExternalID}}" data-post-content="{{.Content}}" title="Editar">
              {{template "icon-pencil" $}}
            </button>
            <button type="button" class="delete-post-btn btn btn-sm btn-outline-danger action-btn-square" data-post-id="{{.ExternalID}}" title="Deletar">
              {{template "icon-trash" $}}
            </button>
          </div>
        {{end}}
      </div>
      <!-- Post content -->
      <div class="card-text">
        {{if .ContentHTML}}
          {{.ContentHTML | safeHTML}}
        {{else}}
          {{.Content}}
        {{end}}
      </div>
    </div>
  </div>
{{else}}
  <div class="alert alert-info text-center mb-0">
    <p class="mb-0">Nenhuma resposta neste tópico ainda.</p>
  </div>
{{end}}
{{end}}
