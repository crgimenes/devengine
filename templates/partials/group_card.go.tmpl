{{define "group_card"}}
{{$node := .Node}}
{{$values := .Values}}
{{$depth := .Depth}}
{{$meta := .Meta}}
{{$showHeader := index $meta "show_header"}}
{{$headerBg := index $meta "header_bg"}}
<div class="col-12 col-md-{{$node.Element.ColSpan}}">
    <div class="card mb-3">
        {{if and $showHeader $node.Element.Label}}
        <div class="card-header {{if eq $headerBg "primary"}}bg-primary text-white{{else if eq $headerBg "dark"}}bg-dark text-white{{end}}">
            {{$node.Element.Label}}
        </div>
        {{end}}
        <div class="card-body">
            {{if $node.Element.HelpText}}<p class="card-text text-muted">{{$node.Element.HelpText}}</p>{{end}}
            <div class="row">
                {{range $node.Children}}
                    {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 1))}}
                {{end}}
            </div>
        </div>
    </div>
</div>
{{end}}
