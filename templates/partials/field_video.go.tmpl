{{define "field_video"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}

<div class="field-video-container" data-video-options="{{$meta}}">
    {{/* Preview area */}}
    <div class="field-video-preview-wrapper mb-2" id="{{$name}}_preview_wrapper">
        {{if $value}}
        <video src="{{$value}}" 
               {{if index $meta "controls"}}controls{{end}}
               {{if index $meta "autoplay"}}autoplay{{end}}
               {{if index $meta "loop"}}loop{{end}}
               {{if index $meta "muted"}}muted{{end}}
               playsinline
               class="field-video-preview rounded w-100" 
               id="{{$name}}_preview"></video>
        {{else}}
        <div class="field-video-placeholder text-center text-muted p-4 border rounded bg-body-secondary {{if not $readonly}}cursor-pointer{{end}}"
             {{if not $readonly}}
             role="button"
             data-bs-toggle="modal"
             data-bs-target="#fileManagerModal"
             data-field-name="{{$name}}"
             title="{{t .Locale "Click to pick a video"}}"
             {{end}}>
            <svg class="mb-2" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V1zm4 0v6h8V1H4zm8 8H4v6h8V9zM1 1v2h2V1H1zm2 3H1v2h2V4zM1 7v2h2V7H1zm2 3H1v2h2v-2zm-2 3v2h2v-2H1zM15 1h-2v2h2V1zm-2 3v2h2V4h-2zm2 3h-2v2h2V7zm-2 3v2h2v-2h-2zm2 3h-2v2h2v-2z"/>
            </svg>
            <div class="small">{{t .Locale "No video selected"}}</div>
        </div>
        {{end}}
    </div>

    {{/* Hidden input to store URL */}}
    <input type="hidden" id="{{$name}}" name="{{$name}}" value="{{$value}}" 
           class="field-video-input" {{if $required}}required{{end}}>

    {{/* Buttons - only show if not readonly */}}
    {{if not $readonly}}
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm field-video-select-btn"
                data-field-name="{{$name}}" data-bs-toggle="modal" data-bs-target="#fileManagerModal">
            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V1zm4 0v6h8V1H4zm8 8H4v6h8V9zM1 1v2h2V1H1zm2 3H1v2h2V4zM1 7v2h2V7H1zm2 3H1v2h2v-2zm-2 3v2h2v-2H1zM15 1h-2v2h2V1zm-2 3v2h2V4h-2zm2 3h-2v2h2V7zm-2 3v2h2v-2h-2zm2 3h-2v2h2v-2z"/>
            </svg>
            {{t .Locale "Pick video"}}
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm field-video-remove-btn {{if not $value}}d-none{{end}}"
                data-field-name="{{$name}}">
            <svg width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
            </svg>
            Remove
        </button>
    </div>
    {{end}}
</div>
{{end}}
