{{define "group_tabs"}}
{{$node := .Node}}
{{$values := .Values}}
{{$depth := .Depth}}
{{$meta := .Meta}}
{{$form := .Form}}
{{$recordRef := .RecordRefID}}
{{$activeTab := index $meta "active_tab"}}
{{$tabPosition := index $meta "tab_position"}}
<div class="col-12 col-md-{{$node.Element.ColSpan}}">
    <div class="mb-3">
        {{if $node.Element.Label}}<h6 class="mb-2">{{$node.Element.Label}}</h6>{{end}}
        {{if $node.Element.HelpText}}<small class="text-muted d-block mb-2">{{$node.Element.HelpText}}</small>{{end}}
        
        {{/* Tab navigation */}}
        <ul class="nav nav-tabs" id="tabs_{{$node.Element.MachineName}}" role="tablist">
            {{range $idx, $child := $node.Children}}
            <li class="nav-item" role="presentation">
                <button class="nav-link {{if eq $idx $activeTab}}active{{end}}" 
                        id="tab_{{$node.Element.MachineName}}_{{$idx}}" 
                        data-bs-toggle="tab" 
                        data-bs-target="#tabpane_{{$node.Element.MachineName}}_{{$idx}}" 
                        type="button" role="tab"
                        aria-controls="tabpane_{{$node.Element.MachineName}}_{{$idx}}" 
                        aria-selected="{{if eq $idx $activeTab}}true{{else}}false{{end}}">
                    {{$child.Element.Label}}
                </button>
            </li>
            {{end}}
        </ul>
        
        {{/* Tab content */}}
        <div class="tab-content border border-top-0 rounded-bottom p-3" id="tabcontent_{{$node.Element.MachineName}}">
            {{range $idx, $child := $node.Children}}
            <div class="tab-pane fade {{if eq $idx $activeTab}}show active{{end}}" 
                 id="tabpane_{{$node.Element.MachineName}}_{{$idx}}" 
                 role="tabpanel" 
                 aria-labelledby="tab_{{$node.Element.MachineName}}_{{$idx}}">
                {{if $child.Element.HelpText}}<p class="text-muted mb-3">{{$child.Element.HelpText}}</p>{{end}}
                <div class="row">
                    {{range $child.Children}}
                        {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 2) "Form" $form "RecordRefID" $recordRef)}}
                    {{end}}
                </div>
            </div>
            {{end}}
        </div>
    </div>
</div>
{{end}}
