{{define "group_accordion"}}
{{$node := .Node}}
{{$values := .Values}}
{{$depth := .Depth}}
{{$meta := .Meta}}
{{$form := .Form}}
{{$recordRef := .RecordRefID}}
{{$expanded := index $meta "expanded_by_default"}}
{{$showHeader := index $meta "show_header"}}
<div class="col-12 col-md-{{$node.Element.ColSpan}}">
    <div class="accordion mb-3" id="accordion_{{$node.Element.MachineName}}">
        <div class="accordion-item">
            {{if $showHeader}}
            <h2 class="accordion-header">
                <button class="accordion-button {{if not $expanded}}collapsed{{end}}" 
                        type="button" data-bs-toggle="collapse" 
                        data-bs-target="#collapse_{{$node.Element.MachineName}}" 
                        aria-expanded="{{$expanded}}">
                    {{$node.Element.Label}}
                </button>
            </h2>
            {{end}}
            <div id="collapse_{{$node.Element.MachineName}}" 
                 class="accordion-collapse collapse {{if $expanded}}show{{end}}"
                 data-bs-parent="#accordion_{{$node.Element.MachineName}}">
                <div class="accordion-body">
                    {{if $node.Element.HelpText}}<p class="text-muted">{{$node.Element.HelpText}}</p>{{end}}
                    <div class="row">
                        {{range $node.Children}}
                            {{template "render_element" (dict "Node" . "Values" $values "Depth" (add $depth 1) "Form" $form "RecordRefID" $recordRef "Locale" $.Locale)}}
                        {{end}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
