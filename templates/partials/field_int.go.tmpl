{{define "field_int"}}
{{$meta := .Meta}}
{{$name := .Name}}
{{$value := .Value}}
{{$required := .Required}}
{{$readonly := .Readonly}}
<input type="number" 
       class="form-control" 
       id="{{$name}}" 
       name="{{$name}}"
       value="{{$value}}"
       {{if index $meta "min"}}min="{{index $meta "min"}}"{{end}}
       {{if index $meta "max"}}max="{{index $meta "max"}}"{{end}}
       {{if index $meta "step"}}step="{{index $meta "step"}}"{{end}}
       {{if index $meta "placeholder"}}placeholder="{{index $meta "placeholder"}}"{{end}}
       {{if $required}}required{{end}}
       {{if $readonly}}readonly{{end}}>
{{end}}
