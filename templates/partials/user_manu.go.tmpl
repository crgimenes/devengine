{{define "user_menu"}}
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" 
       href="#" 
       id="userDropdown" 
       role="button" 
       data-bs-toggle="dropdown" 
       aria-expanded="false">
        <span class="user-name">{{.User.Username}}</span>
        {{if .User.AvatarURL}}
            <img 
                src="{{.User.AvatarURL}}" 
                alt="Avatar" 
                class="rounded-circle avatar-sm">
        {{else}}
            <span class="badge bg-secondary rounded-circle avatar-placeholder-sm d-flex align-items-center justify-content-center">
                {{first .User.Username}}
            </span>
        {{end}}
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
      <li><span class="dropdown-item-text">{{.User.Email}}</span></li>
      <li><hr class="dropdown-divider"></li>
      <li><a class="dropdown-item" href="/me">Meu Perfil</a></li>
      <li><a class="dropdown-item" href="/files">Meus Arquivos</a></li>
      {{if .User.Sysop}}
      {{template "tools_menu" .}}
      {{end}}
      <li><hr class="dropdown-divider"></li>
      <li><a class="dropdown-item" href="/logout">Sair</a></li>
    </ul>
</li>
{{end}}
