{{define "single_post"}}
{{$postAuthor := .Author}}
<div class="card mb-3">
  <div class="card-body">
    <!-- Post header with author info -->
    <div class="d-flex justify-content-between align-items-center mb-2">
      <div class="d-flex align-items-center gap-2">
        <!-- Avatar -->
        {{if $postAuthor.AvatarURL}}
          <img src="{{$postAuthor.AvatarURL}}" alt="{{$postAuthor.Username}}" class="rounded-circle avatar-sm" width="32" height="32">
        {{else}}
          <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center avatar-placeholder-sm">
            <span class="text-white fw-bold">{{first $postAuthor.Username}}</span>
          </div>
        {{end}}
        <!-- Author name and timestamp -->
        <div>
          <div class="fw-bold font-sm">{{$postAuthor.Username}}</div>
          <small class="text-body-secondary font-xs">{{.Post.CreatedAt.Format "2006-01-02 15:04"}}</small>
        </div>
      </div>
      <!-- Action buttons (only visible to post author) -->
      {{if eq .CurrentUser.ID .Post.OwnerUserID}}
        <div class="d-flex gap-2" role="group">
          <button type="button" class="edit-post-btn btn btn-sm btn-outline-secondary action-btn-square" data-post-id="{{.Post.ExternalID}}" data-post-content="{{.Post.Content}}" title="Editar">
            {{template "icon-pencil" .}}
          </button>
          <button type="button" class="delete-post-btn btn btn-sm btn-outline-danger action-btn-square" data-post-id="{{.Post.ExternalID}}" title="Deletar">
            {{template "icon-trash" .}}
          </button>
        </div>
      {{end}}
    </div>
    <!-- Post content -->
    <div class="card-text">
      {{if .Post.ContentHTML}}
        {{.Post.ContentHTML | safeHTML}}
      {{else}}
        {{.Post.Content}}
      {{end}}
    </div>
  </div>
</div>
{{end}}
