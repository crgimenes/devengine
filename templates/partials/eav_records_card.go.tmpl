{{define "eav_records_card"}}
{{if .Records}}
<div class="row g-3 g-md-4 records-card-view">
    {{range $recIdx, $recWithVals := $.Records}}
    <div class="col-12 col-md-{{if $.Form.CardCols}}{{$.Form.CardCols}}{{else}}6{{end}}">
        <article class="card h-100 shadow-sm clickable-record" data-record-url="{{$.BasePath}}/records/{{$recWithVals.Record.ReferenceID}}">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="card-title h6 mb-1">Registro #{{$recWithVals.Record.ID}}</h5>
                        <p class="text-muted small mb-0">
                            Ref: <code class="small">{{$recWithVals.Record.ReferenceID}}</code>
                        </p>
                    </div>
                    <span class="badge {{if eq $recWithVals.Record.Status "active"}}text-bg-success{{else}}text-bg-secondary{{end}}">
                        {{if eq $recWithVals.Record.Status "active"}}Ativo{{else}}Inativo{{end}}
                    </span>
                </div>

                <div class="row g-2 flex-grow-1">
                    {{range $row := $recWithVals.FieldRows}}
                        {{range $item := $row.Children}}
                            <div class="col-12 col-md-{{$item.ColumnWidth}}">
                                {{$item.Content}}
                            </div>
                        {{end}}
                    {{end}}
                </div>


                <div class="mt-auto pt-3">
                    <div class="d-grid gap-2">
                        <a href="{{$.BasePath}}/records/{{$recWithVals.Record.ReferenceID}}" class="btn btn-sm btn-outline-light" onclick="event.stopPropagation();">
                            Ver
                        </a>
                        <a href="{{$.BasePath}}/records/{{$recWithVals.Record.ReferenceID}}/edit" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation();">
                            Editar
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </div>
    {{end}}
</div>
{{else}}
<div class="card border-0 bg-body-secondary bg-opacity-25">
    <div class="card-body text-center py-5">
        <p class="text-muted mb-3">Nenhum registro disponível.</p>
        <a href="{{$.BasePath}}/records/new" class="btn btn-primary">Criar primeiro registro</a>
    </div>
</div>
{{end}}
{{end}}
