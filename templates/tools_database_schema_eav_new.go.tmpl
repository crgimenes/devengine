<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">New EAV Table</h2>
                        <a href="/tools/database-schema" class="btn btn-secondary">
                            Cancelar
                        </a>
                    </div>
                    
                    <p class="text-muted mb-4">
                        Crie uma nova tabela EAV (Entity-Attribute-Value). Após criar a tabela, você poderá adicionar campos (atributos).
                    </p>

                    <form method="POST" action="/tools/database-schema/eav/new" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="name" class="form-label">Nome <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="name" 
                                name="name" 
                                value="{{.FormData.Name}}"
                                required
                                maxlength="100"
                                placeholder="Ex: Produtos, Clientes, Projetos"
                            >
                            <div class="invalid-feedback">
                                Por favor, informe um nome para a tabela.
                            </div>
                            <div class="form-text">Nome legível para humanos</div>
                        </div>

                        <div class="mb-3">
                            <label for="machine_name" class="form-label">Nome da Máquina <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control font-monospace" 
                                id="machine_name" 
                                name="machine_name" 
                                value="{{.FormData.MachineName}}"
                                required
                                pattern="[a-z][a-z0-9_]*"
                                maxlength="100"
                                placeholder="Ex: produtos, clientes, projetos"
                            >
                            <div class="invalid-feedback">
                                Apenas letras minúsculas, números e underscores. Deve começar com letra.
                            </div>
                            <div class="form-text">Identificador único (gerado automaticamente do nome)</div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">Descrição</label>
                            <textarea 
                                class="form-control" 
                                id="description" 
                                name="description" 
                                rows="3"
                                maxlength="500"
                                placeholder="Descreva o propósito desta tabela..."
                            >{{.FormData.Description}}</textarea>
                            <div class="form-text">Opcional, até 500 caracteres</div>
                        </div>

                        <div class="mb-4">
                            <label for="pos_load" class="form-label">Script Pós-Carregamento (Filo)</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pos_load" 
                                name="pos_load" 
                                rows="6"
                                placeholder="(set campo (str-concat campo &quot; - editado&quot;))"
                            >{{.FormData.PosLoad}}</textarea>
                            <div class="form-text">
                                Código Filo executado após carregar registros e defaults, antes de exibir.
                                Se "error" estiver preenchida, mostra a mensagem na tela.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="pre_save" class="form-label">Script Pré-Salvamento (Filo)</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pre_save" 
                                name="pre_save" 
                                rows="6"
                                placeholder="(set error &quot;Mensagem de erro&quot;)"
                            >{{.FormData.PreSave}}</textarea>
                            <div class="form-text">
                                Código Filo executado antes de salvar registros. 
                                Se "error" estiver preenchida, o salvamento é bloqueado.
                            </div>
                        </div>


                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Criar Tabela</button>
                            <a href="/tools/database-schema" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    
    {{template "scripts" .}}
    <script src="/assets/eav-entity-form.js"></script>
  </body>
</html>
