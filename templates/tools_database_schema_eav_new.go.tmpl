<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">{{t $.Locale "New EAV table"}}</h2>
                        <a href="/tools/database-schema" class="btn btn-secondary">
                            {{t $.Locale "Cancel"}}
                        </a>
                    </div>
                    
                    <p class="text-muted mb-4">
                        {{t $.Locale "Create a new EAV (Entity-Attribute-Value) table. After creating it you can add fields (attributes)."}}
                    </p>

                    <form method="POST" action="/tools/database-schema/eav/new" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="name" class="form-label">{{t $.Locale "Name"}} <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="name" 
                                name="name" 
                                value="{{.FormData.Name}}"
                                required
                                maxlength="100"
                                placeholder="{{t $.Locale "e.g. Products, Customers, Projects"}}"
                            >
                            <div class="invalid-feedback">
                                Por favor, informe um nome para a tabela.
                            </div>
                            <div class="form-text">{{t $.Locale "Human-readable name"}}</div>
                        </div>

                        <div class="mb-3">
                            <label for="machine_name" class="form-label">{{t $.Locale "Machine name"}} <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control font-monospace" 
                                id="machine_name" 
                                name="machine_name" 
                                value="{{.FormData.MachineName}}"
                                required
                                pattern="[a-z][a-z0-9_]*"
                                maxlength="100"
                                placeholder="{{t $.Locale "e.g. products, customers, projects"}}"
                            >
                            <div class="invalid-feedback">
                                {{t $.Locale "Lowercase letters, numbers and underscores only. Must start with a letter."}}
                            </div>
                            <div class="form-text">{{t $.Locale "Unique identifier (generated from the name)"}}</div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                            <textarea 
                                class="form-control" 
                                id="description" 
                                name="description" 
                                rows="3"
                                maxlength="500"
                                placeholder="{{t $.Locale "Describe the purpose of this table…"}}"
                            >{{.FormData.Description}}</textarea>
                            <div class="form-text">{{t $.Locale "Optional, up to 500 characters"}}</div>
                        </div>

                        <div class="mb-4">
                            <label for="pos_load" class="form-label">{{t $.Locale "Post-load script (Filo)"}}</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pos_load" 
                                name="pos_load" 
                                rows="6"
                                placeholder="(set field (str-concat field &quot; - edited&quot;))"
                            >{{.FormData.PosLoad}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Filo code run after loading records and defaults, before display. A non-empty \"error\" shows the message on screen."}}
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="pre_save" class="form-label">{{t $.Locale "Pre-save script (Filo)"}}</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pre_save" 
                                name="pre_save" 
                                rows="6"
                                placeholder="(set error &quot;Error message&quot;)"
                            >{{.FormData.PreSave}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Filo code run before saving records. A non-empty \"error\" blocks the save."}}
                            </div>
                        </div>


                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">{{t $.Locale "Create table"}}</button>
                            <a href="/tools/database-schema" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    
    {{template "scripts" .}}
    <script src="/assets/slugify.js"></script>
    <script src="/assets/eav-entity-form.js"></script>
  </body>
</html>
