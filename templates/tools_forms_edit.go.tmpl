<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Form Info Card -->
                <div class="card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-1">{{.Form.Label}}</h2>
                            <small class="text-muted">{{.Form.MachineName}}</small>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/form/{{.Form.MachineName}}" class="btn btn-success{{if not .EntityType}} disabled{{end}}"{{if not .EntityType}} aria-disabled="true"{{end}} target="_blank">
                                <i class="bi bi-play-fill me-1"></i>Testar
                            </a>
                            <a href="/tools/forms/{{.Form.ReferenceID}}/records" class="btn btn-outline-secondary{{if not .EntityType}} disabled{{end}}"{{if not .EntityType}} aria-disabled="true"{{end}}>
                                Registros
                            </a>
                            <a href="/tools/forms" class="btn btn-secondary">Voltar</a>
                        </div>
                    </div>
                    
                    <form method="post" action="/tools/forms/{{.Form.ReferenceID}}/update">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="label" class="form-label">Label</label>
                                <input type="text" class="form-control" id="label" name="label" 
                                       value="{{.Form.Label}}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="machine_name" class="form-label">Nome (machine_name)</label>
                                <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                       value="{{.Form.MachineName}}" required pattern="[a-zA-Z][a-zA-Z0-9_]*">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label">Descrição</label>
                            <textarea class="form-control" id="description" name="description" rows="2">{{.Form.Description}}</textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="entity_type_id" class="form-label">Tabela EAV</label>
                            <select class="form-select" id="entity_type_id" name="entity_type_id">
                                <option value="">-- Sem vínculo --</option>
                                {{range .EntityTypes}}
                                <option value="{{.ReferenceID}}" {{if $.EntityType}}{{if eq .ID $.EntityType.ID}}selected{{end}}{{end}}>
                                    {{.Name}} ({{.MachineName}})
                                </option>
                                {{end}}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="menu_id" class="form-label">Menu</label>
                            <select class="form-select" id="menu_id" name="menu_id">
                                <option value="">-- Sem menu --</option>
                                {{range .Menus}}
                                <option value="{{.ReferenceID}}" {{if eq .ID $.SelectedMenuID}}selected{{end}}>
                                    {{.Label}} ({{.MachineName}})
                                </option>
                                {{end}}
                            </select>
                            <div class="form-text">Menu exibido na navbar quando o formulário está ativo.</div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Opções de Exibição</label>
                             <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="hide_title" name="hide_title"
                                       {{if .Form.HideTitle}}checked{{end}}>
                                <label class="form-check-label" for="hide_title">
                                    Ocultar título do formulário
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="hide_submit_button" name="hide_submit_button"
                                       {{if .Form.HideSubmitButton}}checked{{end}}>
                                <label class="form-check-label" for="hide_submit_button">
                                    Ocultar botão de envio (Criar/Salvar)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="hide_cancel_button" name="hide_cancel_button"
                                       {{if .Form.HideCancelButton}}checked{{end}}>
                                <label class="form-check-label" for="hide_cancel_button">
                                    Ocultar botão Cancelar
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="is_search" name="is_search"
                                       {{if .Form.IsSearch}}checked{{end}}>
                                <label class="form-check-label" for="is_search">
                                    Formulário de pesquisa (abre na listagem)
                                </label>
                                <div class="form-text">Acessar /form/{nome} mostra a listagem com busca; os campos do formulário definem as colunas.</div>
                            </div>
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" id="show_system_info" name="show_system_info"
                                       {{if .Form.ShowSystemInfo}}checked{{end}}>
                                <label class="form-check-label" for="show_system_info">
                                    Mostrar dados do registro (Debug)
                                </label>
                                <div class="form-text">Exibe ID, RefID e Status no topo do formulário.</div>
                            </div>
                            <div class="form-text">Marque para formulários que não gerenciam registros diretamente.</div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    </form>
                </div>
                
                <!-- Elements Card -->
                <div class="card p-4">
                    <h4 class="mb-3">Elementos do Formulário</h4>
                    
                    {{if .Elements}}
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th class="w-60px">Ordem</th>
                                    <th>Nome</th>
                                    <th class="w-90px">Tipo</th>
                                    <th>Label</th>
                                    <th class="w-60px" title="Largura em colunas Bootstrap (1-12)">Col</th>
                                    <th>Pai</th>
                                    <th>Campo EAV</th>
                                    <th class="text-end text-nowrap w-160px">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="elements-tbody">
                                {{template "elements_table_rows" .}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <div class="alert alert-secondary mb-4">
                        <i class="bi bi-info-circle"></i> Nenhum elemento adicionado ainda.
                    </div>
                    {{end}}
                    
                    <!-- Add Element Form -->
                    <div class="border rounded p-3 bg-dark">
                        <h6 class="mb-3">Adicionar Elemento</h6>
                        <form method="post" action="/tools/forms/{{.Form.ReferenceID}}/elements/new" id="add-element-form">
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <label class="form-label">Tipo</label>
                                    <select class="form-select form-select-sm" name="element_kind" id="element_kind">
                                        <option value="field">Campo</option>
                                        <option value="group">Grupo (fieldset)</option>
                                        <option value="accordion">Accordion</option>
                                        <option value="card">Card</option>
                                        <option value="tabs">Tabs</option>
                                        <option value="carousel">Carousel</option>
                                        <option value="button">Botão de Ação</option>
                                        <option value="divider">Divisor</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Campo EAV (opcional)</label>
                                    <select class="form-select form-select-sm" name="eav_attribute_id" id="eav_attribute_select">
                                        <option value="" data-label="" data-machine="">-- Apenas UI --</option>
                                        {{range .EAVAttributes}}
                                        <option value="{{.ReferenceID}}" data-label="{{.Label}}" data-machine="{{.MachineName}}">{{.Label}} ({{.MachineName}})</option>
                                        {{end}}
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Label</label>
                                    <input type="text" class="form-control form-control-sm" name="label" id="element_label" placeholder="Nome visível">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Nome</label>
                                    <input type="text" class="form-control form-control-sm" name="machine_name" id="element_machine_name"
                                           required placeholder="campo_nome">
                                </div>
                                <div class="col-md-1 d-flex align-items-end">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">+</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/slugify.js"></script>
    <script src="/assets/forms-element-autofill.js"></script>
  </body>
</html>
