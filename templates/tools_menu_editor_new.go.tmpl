<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <h2 class="mb-3">Novo Menu</h2>
                    
                    {{if .Error}}
                    <div class="alert alert-danger">{{.Error}}</div>
                    {{end}}

                    <form method="post" action="/tools/menu-editor/new">
                        <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                        
                        <div class="mb-3">
                            <label for="label" class="form-label">Nome</label>
                            <input type="text" class="form-control" id="label" name="label" 
                                   value="{{if .FormData}}{{.FormData.Label}}{{end}}" required
                                   data-label-source>
                        </div>

                        <div class="mb-3">
                            <label for="machine_name" class="form-label">Nome da Máquina</label>
                            <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                   value="{{if .FormData}}{{.FormData.MachineName}}{{end}}" required
                                   pattern="[a-z][a-z0-9_]*"
                                   data-slug-target>
                            <div class="form-text">Identificador único. Apenas letras minúsculas, números e underscores.</div>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Descrição</label>
                            <textarea class="form-control" id="description" name="description" rows="2">{{if .FormData}}{{.FormData.Description}}{{end}}</textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Criar Menu</button>
                            <a href="/tools/menu-editor" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/forms-label-slug.js"></script>
  </body>
</html>
