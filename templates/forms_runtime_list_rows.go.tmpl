{{define "forms_runtime_list_rows"}}
{{$form := .Form}}
{{range .Rows}}
<tr>
    {{$values := .Values}}
    {{range $.Attributes}}
    <td>
        {{$v := index $values .MachineName}}
        {{if eq $v nil}}<span class="text-muted">—</span>
        {{else if eq .PrimitiveKind "BOOL"}}{{if $v}}Sim{{else}}Não{{end}}
        {{else if eq .PrimitiveKind "DATETIME"}}{{fmtDatetime $v}}
        {{else}}{{$v}}{{end}}
    </td>
    {{end}}
    <td class="text-end">
        <a class="btn btn-sm btn-outline-primary"
           href="/form/{{$form.MachineName}}/r/{{.Record.ReferenceID}}">Abrir</a>
    </td>
</tr>
{{end}}
{{if .NextCursor}}
<tr id="records-sentinel"
    hx-get="/form/{{$form.MachineName}}/list/rows?cursor={{.NextCursor}}{{if .Filter}}&q={{.Filter}}{{end}}"
    hx-trigger="intersect once"
    hx-swap="outerHTML"
    hx-target="this">
    <td colspan="{{.ColCount}}" class="text-center text-muted py-3">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        Carregando mais…
    </td>
</tr>
{{end}}
{{end}}
