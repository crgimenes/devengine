<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
<head>
    {{template "head" .}}
    <link rel="stylesheet" href="/assets/use-bootstrap-tag.min.css?v={{.Config.GitTag}}">
    <title>{{t $.Locale "Upload file"}}</title>
    
    
</head>

<body>
    {{template "navbar" .}}

    <main class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title mb-4">{{t $.Locale "Upload file"}}</h1>

                        {{if .Error}}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{.Error}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        {{if .Message}}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                {{.Message}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        <form method="POST" action="/files/upload" class="needs-validation" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">

                            <!-- File Upload -->
                            <div class="mb-4">
                                <label for="file" class="form-label">{{t $.Locale "File"}}</label>
                                <input class="form-control form-control-lg" type="file" id="file" name="file" accept="image/*,video/*,audio/*" required>
                                <small class="form-text text-body-secondary">{{t $.Locale "Accepted types: images (JPG, PNG, GIF, WebP), videos (MP4, WebM, Ogg), audio (MP3, WAV, OGG)"}}</small>
                            </div>

                            <input type="hidden" id="original_filename" name="original_filename">

                            <!-- File Description -->
                            <div class="mb-4">
                                <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                                <textarea 
                                    class="form-control" 
                                    id="description" 
                                    name="description" 
                                    rows="3" 
                                    placeholder="{{t $.Locale "Describe the file or add notes about its content"}}" 
                                    maxlength="500"></textarea>
                                <small class="form-text text-body-secondary">{{t $.Locale "Maximum 500 characters"}}</small>
                            </div>

                            <!-- Categorias (tags) -->
                            <div class="mb-4">
                                <label for="tagInput" class="form-label">Categorias</label>
                                <input id="tagInput" type="text" name="filetag" class="form-control" value="" placeholder="{{t $.Locale "Type and press Enter"}}" autocomplete="off" data-ub-tag-separator="," data-ub-tag-max="20">
                                <div class="form-text" id="tagHelp">{{t $.Locale "Press Enter, comma or Tab to create a tag. Accents are allowed; commas are not allowed inside a tag."}}</div>
                                <div class="invalid-feedback">{{t $.Locale "Invalid tags. Use letters (accents ok), numbers, space and . _ - /. Max 32 chars per tag, 20 tags, 512 total."}}</div>
                            </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end gap-2">
                                <a href="/files" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                                <button type="submit" class="btn btn-primary">{{t $.Locale "Upload file"}}</button>
                            </div>
                        </form>

                        <hr class="my-4">

                        <!-- File Type Reference -->
                        <div class="card bg-body-secondary border-0">
                            <div class="card-body">
                                <h6 class="card-title mb-3">{{t $.Locale "Supported file types"}}</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Imagens:</strong>
                                        <small class="d-block text-body-secondary">JPEG, PNG, GIF, WebP</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">{{t $.Locale "Videos"}}:</strong>
                                        <small class="d-block text-body-secondary">MP4, WebM, Ogg</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">{{t $.Locale "Audio"}}:</strong>
                                        <small class="d-block text-body-secondary">MP3, WAV, OGG, M4A</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Limite:</strong>
                                        <small class="d-block text-body-secondary">{{t $.Locale "Maximum 500 MB per file"}}</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/use-bootstrap-tag.min.js?v={{.Config.GitTag}}" defer></script>
    <script src="/assets/filemanager-upload.min.js?v={{.Config.GitTag}}" defer></script>
</body>
</html>
