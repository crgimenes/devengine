<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">{{t $.Locale "Database Schema"}}</h2>
                        <a href="/tools/database-schema/eav/new" class="btn btn-primary">
                            New EAV Table
                        </a>
                    </div>
                    
                    <p class="text-muted mb-4">
                        {{t $.Locale "Relational tables (created by migrations) and EAV tables (dynamic entities)."}}
                    </p>

                    {{if .Tables}}
                        <div class="list-group">
                            {{range .Tables}}
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center eav-table-row schema-table-row"
                                     {{if .IsEAV}}data-records-url="/tools/database-schema/eav/{{.ReferenceID}}/records"{{end}}>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h5 class="mb-1">{{.DisplayName}}</h5>
                                            {{if .IsEAV}}
                                                <span class="badge badge-eav">EAV</span>
                                            {{else}}
                                                <span class="badge badge-relational">{{t $.Locale "Relational"}}</span>
                                            {{end}}
                                        </div>
                                        <p class="mb-0 text-muted small">{{.Name}}</p>
                                    </div>
                                    <div class="btn-group" role="group">
                                        {{if .IsEAV}}
                                            <a href="/tools/database-schema/eav/{{.ReferenceID}}/edit" 
                                               class="btn btn-sm btn-outline-primary eav-edit-btn">
                                                {{t $.Locale "Edit structure"}}
                                            </a>
                                        {{else}}
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="{{t $.Locale "Relational table"}}">
                                                View Schema
                                            </button>
                                        {{end}}
                                    </div>
                                </div>
                            {{end}}
                        </div>
                    {{else}}
                        <div class="alert alert-secondary" role="alert">
                            <p class="mb-0">{{t $.Locale "No tables found in the database."}}</p>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/database-schema.js"></script>
  </body>
</html>
