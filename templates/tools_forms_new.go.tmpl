<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <h2 class="mb-4">{{t $.Locale "New form"}}</h2>
                    
                    <form method="post" action="/tools/forms/new">
                        <div class="mb-3">
                            <label for="label" class="form-label">Label *</label>
                            <input type="text" class="form-control" id="label" name="label" 
                                   required placeholder="{{t $.Locale "e.g. Customer registration"}}">
                            <div class="form-text">{{t $.Locale "Name shown to the user"}}</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="machine_name" class="form-label">{{t $.Locale "Machine name"}} *</label>
                            <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                   required pattern="[a-zA-Z][a-zA-Z0-9_]*" 
                                   placeholder="{{t $.Locale "e.g. customer_registration"}}">
                            <div class="form-text">{{t $.Locale "Filled automatically from the label. Use letters, numbers and _"}}</div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                            <textarea class="form-control" id="description" name="description" rows="2"
                                      placeholder="{{t $.Locale "Optional form description"}}"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="entity_type_id" class="form-label">EAV table (optional)</label>
                            <select class="form-select" id="entity_type_id" name="entity_type_id">
                                <option value="">-- {{t $.Locale "Pick an EAV table"}} --</option>
                                {{range .EntityTypes}}
                                <option value="{{.ReferenceID}}">{{.Name}} ({{.MachineName}})</option>
                                {{end}}
                            </select>
                            <div class="form-text">{{t $.Locale "Bind to an EAV table to persist data"}}</div>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">{{t $.Locale "Create form"}}</button>
                            <a href="/tools/forms" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/slugify.js"></script>
    <script src="/assets/forms-label-slug.js"></script>
  </body>
</html>

