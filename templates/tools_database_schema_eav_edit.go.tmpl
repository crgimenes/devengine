<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
    <style>
      .badge-type-BOOL { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important; }
      .badge-type-INT { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%) !important; }
      .badge-type-REAL { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%) !important; }
      .badge-type-TEXT { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%) !important; }
      .badge-type-DATETIME { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%) !important; color: #333 !important; }
    </style>
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-4 py-md-5">
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Entity Type Details -->
                <div class="card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-1">{{.EntityType.Name}}</h2>
                            <p class="text-muted mb-0 small font-monospace">{{.EntityType.MachineName}}</p>
                        </div>
                        <a href="/tools/database-schema" class="btn btn-secondary">
                            Voltar
                        </a>
                    </div>
                    {{if .EntityType.Description}}
                        <p class="mb-0">{{.EntityType.Description}}</p>
                    {{end}}
                </div>

                <!-- Attributes List -->
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0">Atributos</h3>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#attributeModal">
                            Novo Atributo
                        </button>
                    </div>

                    {{if .Attributes}}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Tipo</th>
                                        <th>Flags</th>
                                        <th style="width: 150px;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .Attributes}}
                                        <tr>
                                            <td>
                                                <div><strong>{{.Label}}</strong></div>
                                                <div class="text-muted small font-monospace">{{.MachineName}}</div>
                                                {{if .HelpText}}
                                                    <div class="text-muted small">{{.HelpText}}</div>
                                                {{end}}
                                            </td>
                                            <td>
                                                <span class="badge badge-type-{{.PrimitiveKind}}">{{.PrimitiveKind}}</span>
                                            </td>
                                            <td>
                                                {{if .IsRequired}}
                                                    <span class="badge bg-danger">Required</span>
                                                {{end}}
                                                {{if .IsUnique}}
                                                    <span class="badge bg-warning text-dark">Unique</span>
                                                {{end}}
                                                {{if .IsIndexed}}
                                                    <span class="badge bg-info">Indexed</span>
                                                {{end}}
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button 
                                                        type="button" 
                                                        class="btn btn-outline-primary edit-attribute-btn"
                                                        data-attr-id="{{.ReferenceID}}"
                                                        data-machine-name="{{.MachineName}}"
                                                        data-label="{{.Label}}"
                                                        data-help-text="{{.HelpText}}"
                                                        data-primitive-kind="{{.PrimitiveKind}}"
                                                        data-is-required="{{.IsRequired}}"
                                                        data-is-unique="{{.IsUnique}}"
                                                        data-is-indexed="{{.IsIndexed}}"
                                                        data-default-bool="{{if .DefaultVBool}}{{if .DefaultVBool}}1{{else}}0{{end}}{{end}}"
                                                        data-default-int="{{if .DefaultVInt}}{{.DefaultVInt}}{{end}}"
                                                        data-default-real="{{if .DefaultVReal}}{{.DefaultVReal}}{{end}}"
                                                        data-default-text="{{if .DefaultVText}}{{.DefaultVText}}{{end}}"
                                                        data-default-datetime="{{if .DefaultVDatetime}}{{.DefaultVDatetime}}{{end}}"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#attributeModal">
                                                        Editar
                                                    </button>
                                                    <form method="POST" action="/tools/database-schema/eav/{{$.EntityType.ReferenceID}}/attributes/{{.ReferenceID}}/delete" style="display: inline;" class="delete-attribute-form">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                                            Excluir
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="alert alert-secondary mb-0" role="alert">
                            <p class="mb-0">Nenhum atributo criado ainda. Clique em "Novo Atributo" para adicionar campos a esta tabela.</p>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </main>

    <!-- Attribute Modal -->
    <div class="modal fade" id="attributeModal" tabindex="-1" aria-labelledby="attributeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="attributeModalLabel">Novo Atributo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" action="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/new" class="needs-validation" novalidate>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="attr_label" class="form-label">Label <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="attr_label" 
                                name="label" 
                                required
                                maxlength="100"
                                placeholder="ex: Nome do Produto, Preço, Data de Entrega"
                            >
                            <div class="form-text">Texto legível para humanos</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_machine_name" class="form-label">Nome da Máquina <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control font-monospace" 
                                id="attr_machine_name" 
                                name="machine_name" 
                                required
                                pattern="[a-z][a-z0-9_]*"
                                maxlength="100"
                                placeholder="ex: nome_produto, preco, data_entrega"
                            >
                            <div class="invalid-feedback">
                                Apenas letras minúsculas, números e underscores. Deve começar com letra.
                            </div>
                            <div class="form-text">Identificador único (gerado automaticamente do label)</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_help_text" class="form-label">Texto de Ajuda</label>
                            <textarea 
                                class="form-control" 
                                id="attr_help_text" 
                                name="help_text" 
                                rows="2"
                                maxlength="500"
                                placeholder="Descreva o propósito deste campo..."
                            ></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="attr_primitive_kind" class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" id="attr_primitive_kind" name="primitive_kind" required>
                                <option value="">Selecione um tipo...</option>
                                <option value="BOOL">BOOL - Verdadeiro/Falso</option>
                                <option value="INT">INT - Número Inteiro</option>
                                <option value="REAL">REAL - Número Decimal</option>
                                <option value="TEXT">TEXT - Texto</option>
                                <option value="DATETIME">DATETIME - Data/Hora</option>
                            </select>
                        </div>

                        <div class="mb-3" id="default_value_container">
                            <label for="attr_default_value" class="form-label">Valor Padrão</label>
                            <input type="text" class="form-control" id="attr_default_value" name="default_value" placeholder="Selecione um tipo primeiro">
                            <div class="form-text">Valor inicial para novos registros (editável pelo usuário)</div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_required" name="is_required" value="1">
                                <label class="form-check-label" for="attr_is_required">
                                    Campo obrigatório
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_unique" name="is_unique" value="1">
                                <label class="form-check-label" for="attr_is_unique">
                                    Valor único (não permite duplicatas)
                                </label>
                            </div>
                        </div>

                        <div class="mb-0">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_indexed" name="is_indexed" value="1">
                                <label class="form-check-label" for="attr_is_indexed">
                                    Criar índice (melhora performance de buscas)
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar Atributo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer>
      {{template "footer" .}}
    </footer>
    
    {{template "scripts" .}}
    <script src="/assets/eav-attribute-form.js"></script>
  </body>
</html>
