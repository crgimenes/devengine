<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
    <style>
      .badge-type-BOOL { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important; }
      .badge-type-INT { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%) !important; }
      .badge-type-REAL { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%) !important; }
      .badge-type-TEXT { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%) !important; }
      .badge-type-DATETIME { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%) !important; color: #333 !important; }
    </style>
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Entity Type Edit Form -->
                <div class="card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-1">{{t $.Locale "Edit EAV table"}}</h2>
                            <p class="text-muted mb-0 small font-monospace">{{.EntityType.MachineName}}</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/tools/database-schema/eav/{{.EntityID}}/records" class="btn btn-primary">
                                <i class="bi bi-list"></i> Registros
                            </a>
                            <a href="/tools/database-schema" class="btn btn-secondary">
                                Voltar
                            </a>
                        </div>
                    </div>

                    <form method="POST" action="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit">
                        <div class="mb-3">
                            <label for="name" class="form-label">{{t $.Locale "Name"}} <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="name" 
                                name="name" 
                                value="{{.EntityType.Name}}"
                                required
                                maxlength="100"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                            <textarea 
                                class="form-control" 
                                id="description" 
                                name="description" 
                                rows="3"
                                maxlength="500"
                            >{{.EntityType.Description}}</textarea>
                        </div>

                        <div class="mb-4">
                            <label for="pos_load" class="form-label">{{t $.Locale "Post-load script (Filo)"}}</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pos_load" 
                                name="pos_load" 
                                rows="6"
                                placeholder="(set campo (str-concat campo &quot; - editado&quot;))"
                            >{{.EntityType.PosLoad}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Filo code run after loading records and defaults, before display. A non-empty \"error\" shows the message on screen."}}
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="pre_save" class="form-label">{{t $.Locale "Pre-save script (Filo)"}}</label>
                            <textarea 
                                class="form-control font-monospace" 
                                id="pre_save" 
                                name="pre_save" 
                                rows="6"
                                placeholder="(set error &quot;Mensagem de erro&quot;)"
                            >{{.EntityType.PreSave}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Filo code run before saving records. A non-empty \"error\" blocks the save."}}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">{{t $.Locale "Save changes"}}</button>
                    </form>
                </div>

                <!-- Attributes List -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0">{{t $.Locale "Attributes"}}</h3>
                        <a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/new" class="btn btn-primary">
                            {{t $.Locale "New attribute"}}
                        </a>
                    </div>

                    {{if .Attributes}}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>{{t $.Locale "Name"}}</th>
                                        <th>{{t $.Locale "Type"}}</th>
                                        <th>Flags</th>
                                        <th style="width: 150px;">{{t $.Locale "Actions"}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{range .Attributes}}
                                        <tr>
                                            <td>
                                                <div><strong>{{.Label}}</strong></div>
                                                <div class="text-muted small font-monospace">{{.MachineName}}</div>
                                                {{if .HelpText}}
                                                    <div class="text-muted small">{{.HelpText}}</div>
                                                {{end}}
                                            </td>
                                            <td>
                                                <span class="badge badge-type-{{.PrimitiveKind}}">{{.PrimitiveKind}}</span>
                                            </td>
                                            <td>
                                                {{if .IsRequired}}
                                                    <span class="badge bg-danger">Required</span>
                                                {{end}}
                                                {{if .IsUnique}}
                                                    <span class="badge bg-warning text-dark">Unique</span>
                                                {{end}}
                                                {{if .IsIndexed}}
                                                    <span class="badge bg-info">Indexed</span>
                                                {{end}}
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="/tools/database-schema/eav/{{$.EntityType.ReferenceID}}/attributes/{{.ReferenceID}}/edit" 
                                                       class="btn btn-outline-primary">
                                                        {{t $.Locale "Edit"}}
                                                    </a>
                                                    <form method="POST" action="/tools/database-schema/eav/{{$.EntityType.ReferenceID}}/attributes/{{.ReferenceID}}/delete" style="display: inline;" class="delete-attribute-form">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                                            {{t $.Locale "Delete"}}
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {{end}}
                                </tbody>
                            </table>
                        </div>
                    {{else}}
                        <div class="alert alert-secondary mb-0" role="alert">
                            <p class="mb-0">{{t $.Locale "No attributes yet. Click \"New attribute\" to add fields to this table."}}</p>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    
    {{template "scripts" .}}
    <script src="/assets/slugify.js"></script>
  </body>
</html>
