<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "navbar" .}}

    <main class="container py-4">
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <h1 class="mb-4">{{t $.Locale "Invites"}}</h1>

                {{if .Error}}
                <div class="alert alert-danger" role="alert">{{.Error}}</div>
                {{end}}

                {{if .CreatedURL}}
                <div class="alert alert-success" role="alert">
                    <p class="mb-2">Link gerado. Copie e envie manualmente ao convidado:</p>
                    <input type="text"
                           class="form-control"
                           readonly
                           value="{{.CreatedURL}}"
                           data-select-on-click>
                </div>
                {{end}}

                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">{{t $.Locale "Mint a new invite"}}</h5>
                        <form method="post" action="/tools/invites">
                            <div class="mb-3">
                                <label for="email" class="form-label">{{t $.Locale "Invitee email"}}</label>
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="email"
                                       required>
                                <small class="form-text text-muted">
                                    {{t $.Locale "The email is tied to the token. The invitee picks a username and password on acceptance."}}
                                </small>
                            </div>
                            <button type="submit" class="btn btn-primary">{{t $.Locale "Mint link"}}</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
</body>

</html>
