<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">Formulários</h2>
                        <a href="/tools/forms/new" class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i> Novo Formulário
                        </a>
                    </div>
                    <p class="text-muted">Gerenciamento de formulários dinâmicos.</p>
                    
                    {{if .Forms}}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Tabela EAV</th>
                                    <th>Descrição</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{range .Forms}}
                                <tr>
                                    <td>
                                        <a href="/tools/forms/{{.Form.ReferenceID}}/edit">{{.Form.Label}}</a>
                                        <br><small class="text-muted">{{.Form.MachineName}}</small>
                                    </td>
                                    <td>
                                        {{if .EntityTypeName}}
                                            <span class="badge bg-secondary">{{.EntityTypeName}}</span>
                                        {{else}}
                                            <span class="text-muted">-</span>
                                        {{end}}
                                    </td>
                                    <td>{{.Form.Description}}</td>
                                    <td class="text-end">
                                        <a href="/form/{{.Form.MachineName}}" class="btn btn-sm btn-success me-1">Novo</a>
                                        <a href="/tools/forms/{{.Form.ReferenceID}}/edit" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                        <form method="post" action="/tools/forms/{{.Form.ReferenceID}}/delete" class="d-inline" onsubmit="return confirm('Excluir este formulário?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                        </form>
                                    </td>
                                </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <div class="alert alert-secondary">
                        <i class="bi bi-info-circle"></i> Nenhum formulário cadastrado.
                        <a href="/tools/forms/new">Criar o primeiro formulário</a>.
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
