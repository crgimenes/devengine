{{define "filemanager_edit.go.tmpl"}}
<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "navbar" .}}

    <main class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title mb-4 h4 text-break">{{.File.OriginalFilename}}</h1>

                        {{if .Error}}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{.Error}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        <form method="POST" class="needs-validation">
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                            <input type="hidden" name="file_id" value="{{.File.Filename}}">

                            <!-- File preview -->
                            <div class="mb-4">
                                {{/* Preferir metadados do servidor para decidir como prever */}}
                                {{- if eq .MediaKind "audio" -}}
                                    {{/* Audio uses only the control bar, without a square preview box. */}}
                                    <audio src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" class="w-100" controls preload="metadata">
                                        {{t $.Locale "Your browser does not support audio playback."}}
                                    </audio>
                                {{- else -}}
                                    <div class="ratio ratio-1x1 bg-body-secondary d-flex align-items-center justify-content-center rounded overflow-hidden">
                                        {{- if eq .MediaKind "image" -}}
                                            <img src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" alt="{{.File.OriginalFilename}}" class="w-100 h-100 object-fit-contain">
                                        {{- else if eq .MediaKind "video" -}}
                                            <video id="file-preview-video" src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" class="w-100 h-100 object-fit-contain" preload="auto" controls playsinline muted>
                                                {{t $.Locale "Your browser does not support video playback."}}
                                            </video>
                                        {{- else -}}
                                            {{template "icon-file" .}}
                                        {{- end }}
                                    </div>
                                {{- end }}
                                <p class="text-muted small mt-3 mb-0"><strong>{{t $.Locale "File"}}:</strong> {{.File.OriginalFilename}}</p>
                                <p class="text-muted small"><strong>Type:</strong> {{.File.Filetype}}</p>
                                <p class="text-muted small"><strong>Size:</strong> {{.File.Filesize}} bytes</p>
                                {{if eq .File.Filetype "video/mpeg"}}
                                <div class="alert alert-warning alert-sm mt-2" role="alert">
                                    <strong>⚠️ {{t $.Locale "Compatibility:"}}</strong> {{t $.Locale "MPEG files may not play on Chrome. Use Safari, Firefox, or convert to MP4."}}
                                </div>
                                {{end}}
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                                <textarea 
                                    class="form-control" 
                                    id="description" 
                                    name="description" 
                                    rows="3" 
                                    placeholder="{{t $.Locale "Describe the file or add notes about its content"}}" 
                                    maxlength="500">{{.File.Filedescription}}</textarea>
                                <small class="form-text text-body-secondary">{{t $.Locale "Maximum 500 characters"}}</small>
                            </div>

                                                        <!-- Categories (tags) -->
                                                        <div class="mb-4">
                                                                <label for="tagInput" class="form-label">Categories</label>
                                                                <input id="tagInput" type="text" name="filetag" class="form-control" value="{{.File.Filetag}}" placeholder="{{t $.Locale "Type and press Enter"}}" autocomplete="off" data-ub-tag-separator="," data-ub-tag-max="20">
                                                                <div class="form-text" id="tagHelp">{{t $.Locale "Press Enter, comma or Tab to create a tag. Accents are allowed; commas are not allowed inside a tag."}}</div>
                                                                <div class="invalid-feedback">{{t $.Locale "Invalid tags. Use letters (accents ok), numbers, space and . _ - /. Max 32 chars per tag, 20 tags, 512 total."}}</div>
                                                        </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end gap-2">
                                <a href="/files" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                                <button type="submit" class="btn btn-primary">{{t $.Locale "Save changes"}}</button>
                            </div>
                        </form>
                    </div>
                </div>
                <!-- Danger zone: delete file -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h2 class="h6 card-title mb-3">{{t $.Locale "Delete file"}}</h2>
                        <p class="mb-3">Are you sure you want to delete this file?</p>
                        <form method="POST" action="/files/delete">
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                            <input type="hidden" name="file_id" value="{{.File.Filename}}">
                            <button type="submit" class="btn btn-outline-danger d-inline-flex align-items-center gap-2">
                                {{template "icon-trash" .}}
                                <span>{{t $.Locale "Delete file"}}</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <link rel="stylesheet" href="/assets/use-bootstrap-tag.min.css?v={{.Config.GitTag}}">
    <script src="/assets/use-bootstrap-tag.min.js?v={{.Config.GitTag}}" defer></script>
    <script src="/assets/filemanager-edit.min.js?v={{.Config.GitTag}}" defer></script>
</body>
</html>
{{end}}
