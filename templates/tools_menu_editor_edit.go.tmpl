<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .Error}}
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                {{.Error}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Menu Properties Card -->
                <div class="card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">{{.Menu.Label}}</h2>
                        <div>
                            <a href="/tools/menu-editor/{{.Menu.ReferenceID}}/preview" class="btn btn-success me-2">
                                <i class="bi bi-play-fill"></i> Testar Menu
                            </a>
                            <a href="/tools/menu-editor" class="btn btn-outline-secondary">{{t $.Locale "Back"}}</a>
                        </div>
                    </div>
                    
                    <form method="post" action="/tools/menu-editor/{{.Menu.ReferenceID}}/update">
                        <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="label" class="form-label">{{t $.Locale "Name"}}</label>
                                <input type="text" class="form-control" id="label" name="label" 
                                       value="{{.Menu.Label}}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="machine_name" class="form-label">{{t $.Locale "Machine name"}}</label>
                                <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                       value="{{.Menu.MachineName}}" required pattern="[a-z][a-z0-9_]*">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="description" class="form-label">{{t $.Locale "Description"}}</label>
                                <input type="text" class="form-control" id="description" name="description" 
                                       value="{{.Menu.Description}}">
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-sm">{{t $.Locale "Save changes"}}</button>
                    </form>
                </div>

                <!-- Menu Items Card -->
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">{{t $.Locale "Menu items"}}</h4>
                    </div>

                    {{if .Items}}
                    <div class="table-responsive mb-4">
                        <table class="table table-hover table-sm">
                            <thead>
                                <tr>
                                    <th class="col-order">Order</th>
                                    <th>Label</th>
                                    <th>{{t $.Locale "Machine name"}}</th>
                                    <th>{{t $.Locale "Parent item"}}</th>
                                    <th>{{t $.Locale "Icon"}}</th>
                                    <th class="text-end">{{t $.Locale "Actions"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{range .Items}}
                                <tr>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <form method="post" action="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/up" class="d-inline">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm py-0" title="Move up">↑</button>
                                            </form>
                                            <form method="post" action="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/down" class="d-inline">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm py-0" title="Move down">↓</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td>
                                        {{if gt .Depth 0}}
                                            <span class="menu-item-indent indent-depth-{{.Depth}}">↳</span>
                                        {{end}}
                                        {{if .Icon}}<i class="bi {{.Icon}}"></i> {{end}}
                                        <a href="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/edit">
                                            {{if .Label}}{{.Label}}{{else}}<em class="text-muted">{{.MachineName}}</em>{{end}}
                                        </a>
                                    </td>
                                    <td><small class="text-muted">{{.MachineName}}</small></td>
                                    <td>
                                        {{if .ParentLabel}}<span class="badge bg-secondary">{{.ParentLabel}}</span>{{else}}<span class="text-muted">-</span>{{end}}
                                    </td>
                                    <td>{{if .Icon}}<i class="bi {{.Icon}}"></i> <code>{{.Icon}}</code>{{else}}<span class="text-muted">-</span>{{end}}</td>
                                    <td class="text-end">
                                        <a href="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/edit" class="btn btn-sm btn-outline-primary">{{t $.Locale "Edit"}}</a>
                                        <form method="post" action="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/delete" class="d-inline" 
                                              hx-post="/tools/menu-editor/{{$.Menu.ReferenceID}}/items/{{.ReferenceID}}/delete"
                                              hx-confirm="{{t $.Locale "Delete this item?"}}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">{{t $.Locale "Delete"}}</button>
                                        </form>
                                    </td>
                                </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <div class="alert alert-secondary mb-4">
                        <i class="bi bi-info-circle"></i> {{t $.Locale "No items yet. Add them with the form below."}}
                    </div>
                    {{end}}

                    <!-- Add New Item Form -->
                    <div class="card bg-body-secondary p-3">
                        <h6 class="mb-3">{{t $.Locale "Add a new item"}}</h6>
                        <form method="post" action="/tools/menu-editor/{{.Menu.ReferenceID}}/items/new" class="row g-2 align-items-end">
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                            
                            <div class="col-md-3">
                                <label for="new_label" class="form-label form-label-sm">Label</label>
                                <input type="text" class="form-control form-control-sm" id="new_label" 
                                       name="label" placeholder="{{t $.Locale "Home"}}" required>
                            </div>
                            <div class="col-md-3">
                                <label for="new_machine_name" class="form-label form-label-sm">{{t $.Locale "Machine name"}}</label>
                                <input type="text" class="form-control form-control-sm" id="new_machine_name" 
                                       name="machine_name" required pattern="[a-z][a-z0-9_]*" placeholder="home">
                            </div>
                            <div class="col-md-2">
                                <label for="new_icon" class="form-label form-label-sm">{{t $.Locale "Icon"}}</label>
                                <input type="text" class="form-control form-control-sm" id="new_icon" 
                                       name="icon" placeholder="bi-house">
                            </div>
                            <div class="col-md-2">
                                <label for="new_parent_id" class="form-label form-label-sm">{{t $.Locale "Parent item"}}</label>
                                <select class="form-select form-select-sm" id="new_parent_id" name="parent_id">
                                    <option value="">- {{t $.Locale "Root"}} -</option>
                                    {{range .AllItems}}
                                    <option value="{{.ReferenceID}}">{{.Label}}</option>
                                    {{end}}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-sm w-100">{{t $.Locale "Add"}}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/slugify.js"></script>
    <script src="/assets/menu-editor-slug.js"></script>
  </body>
</html>
