<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
    <link rel="stylesheet" href="/assets/eav_ui/image/image.css?v={{.Config.GitTag}}">
    <link rel="stylesheet" href="/assets/eav_ui/video/video.css?v={{.Config.GitTag}}">
    <link rel="stylesheet" href="/assets/eav_ui/audio/audio.css?v={{.Config.GitTag}}">
  </head>
  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/eav">Espaços de trabalho</a></li>
          <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.Workspace.ID}}">Formulários</a></li>
          <li class="breadcrumb-item"><a href="/eav/workspaces/{{.Workspace.ReferenceID}}/forms/{{.Form.MachineName}}/records">Registros</a></li>
          <li class="breadcrumb-item active" aria-current="page">
            {{if eq .Mode "edit"}}Editar{{else}}Novo{{end}} Registro
          </li>
        </ol>
      </nav>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <div>
            <h1 class="h5 mb-0">{{if eq .Mode "edit"}}Editar{{else}}Novo{{end}} Registro</h1>
            <p class="text-muted mb-0">{{.Form.Label}}</p>
          </div>
          <a href="{{.BackURL}}" class="btn btn-outline-light">Voltar</a>
        </div>
        <div class="card-body">
          {{if .Errors}}
          <div class="alert alert-danger" role="alert">
            {{range .Errors}}
              <div>{{.}}</div>
            {{end}}
          </div>
          {{end}}

          <form method="POST" action="{{.ActionURL}}">
            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
            {{if and .Record (eq .Mode "edit")}}
            <input type="hidden" name="record_rev" value="{{.Record.Rev}}">
            {{end}}

            {{range .FieldRows}}
            <div class="row g-3">
              {{range .Children}}
              <div class="col-md-{{.ColumnWidth}}">{{.Content}}</div>
              {{end}}
            </div>
            {{end}}

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Salvar</button>
              <a href="{{.BackURL}}" class="btn btn-outline-light">Cancelar</a>
            </div>
          </form>

          {{if and (eq .Mode "edit") .DeleteURL}}
          <div class="alert alert-danger-subtle border border-danger-subtle rounded mt-4">
            <div class="d-flex flex-column gap-3">
              <div>
                <h2 class="h6 mb-1 text-danger">Excluir registro</h2>
              </div>
              <form method="POST" action="{{.DeleteURL}}" class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center">
                <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" value="on" id="confirm_delete_record" name="confirm_delete" required>
                  <label class="form-check-label" for="confirm_delete_record">Confirmar exclusão.</label>
                </div>
                <button type="submit" class="btn btn-outline-danger ms-lg-auto">Excluir</button>
              </form>
            </div>
          </div>
          {{end}}
        </div>
      </div>
    </main>

    {{template "filemanager_modal" .}}

    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script defer src="/assets/filemanager-modal.min.js?v={{.Config.GitTag}}"></script>
    <script defer src="/assets/eav_ui/image/image.js?v={{.Config.GitTag}}"></script>
    <script defer src="/assets/eav_ui/video/video.js?v={{.Config.GitTag}}"></script>
    <script defer src="/assets/eav_ui/audio/audio.js?v={{.Config.GitTag}}"></script>
  </body>
</html>
