<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
          <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.Form.WorkspaceID}}">Formulários</a></li>
          <li class="breadcrumb-item active" aria-current="page">Editar: {{.Form.Label}}</li>
        </ol>
      </nav>

      <div class="row gy-4">
      <div class="col-12">
        <article class="card shadow-sm">
          <div class="card-header">
            <h2 class="h5 mb-0">Editar formulário</h2>
          </div>
          <div class="card-body">
            <form method="POST" action="/eav/forms/edit?id={{.Form.ID}}" class="row g-3">
              <input type="hidden" name="csrf_token" value="{{.Csrf}}">

              <div class="col-12">
                <label for="label" class="form-label">Nome (label)</label>
                <input type="text" class="form-control" id="label" name="label" value="{{.Form.Label}}" required>
              </div>

              <div class="col-12 col-md-6">
                <label for="machine_name" class="form-label">Machine name</label>
                <input type="text" class="form-control" value="{{.Form.MachineName}}" disabled readonly>
                <div class="form-text">O machine name não pode ser alterado após a criação.</div>
              </div>

              <div class="col-12 col-md-6">
                <div class="form-check mt-4">
                  <input type="checkbox" class="form-check-input" id="active" name="active" {{if .Form.Active}}checked{{end}}>
                  <label class="form-check-label" for="active">Formulário ativo</label>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <label for="default_view_mode" class="form-label">Modo de visualização padrão</label>
                <select class="form-select" id="default_view_mode" name="default_view_mode" required>
                    <option value="list" {{if eq .Form.DefaultViewMode "list"}}selected{{end}}>Lista</option>
                    <option value="card" {{if eq .Form.DefaultViewMode "card"}}selected{{end}}>Cards</option>
                    <option value="carousel" {{if eq .Form.DefaultViewMode "carousel"}}selected{{end}}>Carrossel</option>
                </select>
                <div class="form-text">Visualização padrão para registros deste formulário</div>
              </div>

              <div class="col-12 col-md-6">
                <label for="card_cols" class="form-label">Tamanho do card</label>
                <select class="form-select" id="card_cols" name="card_cols">
                    <option value="12" {{if eq .Form.CardCols 12}}selected{{end}}>12 - Um card por linha</option>
                    <option value="6" {{if or (eq .Form.CardCols 6) (eq .Form.CardCols 0)}}selected{{end}}>6 - Dois cards por linha</option>
                    <option value="4" {{if eq .Form.CardCols 4}}selected{{end}}>4 - Três cards por linha</option>
                    <option value="3" {{if eq .Form.CardCols 3}}selected{{end}}>3 - Quatro cards por linha</option>
                </select>
                <div class="form-text">Número de colunas Bootstrap para cada card na visualização Card</div>
              </div>

              <div class="col-12 d-flex flex-column flex-sm-row gap-2">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a href="/eav/forms?workspace_id={{.Form.WorkspaceID}}" class="btn btn-outline-light">Voltar para lista</a>
              </div>
            </form>
          </div>
        </article>
      </div>

      <div class="col-12">
        <article class="card shadow-sm">
            <div class="card-header d-flex flex-column flex-md-row gap-3 align-items-md-center">
            <div>
              <h2 class="h5 mb-1">Campos do formulário</h2>
              <p class="text-muted mb-0">Gerencie os campos diretamente nesta tela.</p>
            </div>
              <div class="ms-md-auto w-100" style="max-width: 240px;">
                <a href="/eav/fields/create?form_id={{.Form.ID}}" class="btn btn-primary w-100">Adicionar campo</a>
            </div>
          </div>
          <div class="card-body">
            {{if .Fields}}
            <div class="row g-3 g-md-4">
              {{range .Fields}}
              <div class="col-12 col-md-6">
                <article class="card h-100 border border-secondary-subtle">
                  <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                      <div>
                        <h3 class="h6 mb-1">{{.Label}}</h3>
                        <p class="text-muted small mb-1">Machine name: <code>{{.MachineName}}</code></p>
                        <div class="small text-muted">Ordem: {{.ZOrder}}</div>
                      </div>
                      <div class="text-end small text-muted">
                        <div>{{if .UIKind}}{{.UIKind}}{{else}}—{{end}}</div>
                        <div>{{.PrimitiveKind}}</div>
                      </div>
                    </div>

                    <div class="row g-2 small text-muted">
                      <div class="col-6">
                        <div class="fw-semibold">Obrigatório</div>
                        <div>{{if .Required}}Sim{{else}}Não{{end}}</div>
                      </div>
                      <div class="col-6 text-md-end">
                        <div class="fw-semibold">Somente leitura</div>
                        <div>{{if .IsReadonly}}Sim{{else}}Não{{end}}</div>
                      </div>
                    </div>

                    <div class="mt-auto">
                      <a href="/eav/fields/edit?id={{.ID}}" class="btn btn-outline-light w-100">Editar campo</a>
                    </div>
                  </div>
                </article>
              </div>
              {{end}}
            </div>
            {{else}}
            <div class="text-center py-4">
              <p class="text-muted mb-3">Nenhum campo cadastrado ainda.</p>
              <a href="/eav/fields/create?form_id={{.Form.ID}}" class="btn btn-primary">Criar primeiro campo</a>
            </div>
            {{end}}
          </div>
        </article>
      </div>
      </div>
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
