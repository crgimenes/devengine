<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Header -->
                <div class="mb-4">
                    <h2 class="mb-1">
                        {{if .Attribute}}Editar{{else}}Novo{{end}} Atributo - {{.EntityType.Name}}
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/tools">Tools</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema">Database Schema</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit">{{.EntityType.Name}}</a></li>
                            <li class="breadcrumb-item active">{{if .Attribute}}Editar{{else}}Novo{{end}} Atributo</li>
                        </ol>
                    </nav>
                </div>

                <!-- Form Card -->
                <div class="card p-4">
                    <form method="POST" 
                          action="{{if .Attribute}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/{{.Attribute.ReferenceID}}/update{{else}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/new{{end}}"
                          class="needs-validation"
                          novalidate>
                        
                        <div class="mb-3">
                            <label for="attr_label" class="form-label">Label <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="attr_label" 
                                name="label" 
                                required
                                maxlength="100"
                                value="{{if .Attribute}}{{.Attribute.Label}}{{end}}"
                                placeholder="ex: Nome do Produto, Preço, Data de Entrega">
                            <div class="form-text">Texto legível para humanos</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_machine_name" class="form-label">Nome da Máquina <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control font-monospace" 
                                id="attr_machine_name" 
                                name="machine_name" 
                                required
                                {{if not .Attribute}}pattern="[a-z][a-z0-9_]*"{{end}}
                                maxlength="100"
                                value="{{if .Attribute}}{{.Attribute.MachineName}}{{end}}"
                                {{if .Attribute}}readonly{{end}}
                                placeholder="ex: nome_produto, preco, data_entrega">
                            <div class="invalid-feedback">
                                Apenas letras minúsculas, números e underscores. Deve começar com letra.
                            </div>
                            {{if .Attribute}}
                            <div class="form-text text-warning">⚠️ Nome da máquina não pode ser alterado após criação</div>
                            {{else}}
                            <div class="form-text">Identificador único (gerado automaticamente do label)</div>
                            {{end}}
                        </div>

                        <div class="mb-3">
                            <label for="attr_help_text" class="form-label">Texto de Ajuda</label>
                            <textarea 
                                class="form-control" 
                                id="attr_help_text" 
                                name="help_text" 
                                rows="2"
                                maxlength="500"
                                placeholder="Descreva o propósito deste campo...">{{if .Attribute}}{{.Attribute.HelpText}}{{end}}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="attr_primitive_kind" class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" id="attr_primitive_kind" name="primitive_kind" required {{if .Attribute}}disabled{{end}}>
                                <option value="">Selecione um tipo...</option>
                                <option value="BOOL" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "BOOL"}}selected{{end}}{{end}}>BOOL - Verdadeiro/Falso</option>
                                <option value="INT" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "INT"}}selected{{end}}{{end}}>INT - Número Inteiro</option>
                                <option value="REAL" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "REAL"}}selected{{end}}{{end}}>REAL - Número Decimal</option>
                                <option value="TEXT" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "TEXT"}}selected{{end}}{{end}}>TEXT - Texto</option>
                                <option value="DATETIME" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "DATETIME"}}selected{{end}}{{end}}>DATETIME - Data/Hora</option>
                            </select>
                            {{if .Attribute}}
                            <input type="hidden" name="primitive_kind" value="{{.Attribute.PrimitiveKind}}">
                            <div class="form-text text-warning">⚠️ Tipo não pode ser alterado após criação</div>
                            {{end}}
                        </div>

                        <div class="mb-3" id="max_length_container" style="display: {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "TEXT"}}block{{else}}none{{end}}{{else}}none{{end}};">
                            <label for="attr_max_length" class="form-label">Tamanho Máximo (TEXT)</label>
                            <input type="number" 
                                   class="form-control" 
                                   id="attr_max_length" 
                                   name="max_length" 
                                   min="1" 
                                   max="65535"
                                   value="{{if .Attribute}}{{if .Attribute.MaxLength}}{{.Attribute.MaxLength}}{{end}}{{end}}"
                                   placeholder="256">
                            <div class="form-text">Máximo de caracteres permitidos (padrão: 256)</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_default_value" class="form-label">Valor Padrão</label>
                            <input type="text" 
                                   class="form-control" 
                                   id="attr_default_value" 
                                   name="default_value" 
                                   value="{{if .Attribute}}{{if eq .Attribute.PrimitiveKind "BOOL"}}{{if .Attribute.DefaultVBool}}{{if .Attribute.DefaultVBool}}1{{else}}0{{end}}{{end}}{{else if eq .Attribute.PrimitiveKind "INT"}}{{if .Attribute.DefaultVInt}}{{.Attribute.DefaultVInt}}{{end}}{{else if eq .Attribute.PrimitiveKind "REAL"}}{{if .Attribute.DefaultVReal}}{{.Attribute.DefaultVReal}}{{end}}{{else if eq .Attribute.PrimitiveKind "TEXT"}}{{if .Attribute.DefaultVText}}{{.Attribute.DefaultVText}}{{end}}{{else if eq .Attribute.PrimitiveKind "DATETIME"}}{{if .Attribute.DefaultVDatetime}}{{.Attribute.DefaultVDatetime}}{{end}}{{end}}{{end}}"
                                   {{if not .Attribute}}disabled{{end}}
                                   placeholder="Selecione um tipo primeiro">
                            <div class="form-text">Valor inicial para novos registros (editável pelo usuário)</div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_required" name="is_required" value="1" {{if .Attribute}}{{if .Attribute.IsRequired}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_required">
                                    Campo obrigatório
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_unique" name="is_unique" value="1" {{if .Attribute}}{{if .Attribute.IsUnique}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_unique">
                                    Valor único (não permite duplicatas)
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_indexed" name="is_indexed" value="1" {{if .Attribute}}{{if .Attribute.IsIndexed}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_indexed">
                                    Criar índice (melhora performance de buscas)
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                {{if .Attribute}}Atualizar{{else}}Criar{{end}} Atributo
                            </button>
                            <a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    {{template "footer" .}}
    {{template "scripts" .}}
    
    <script defer src="/assets/eav-attribute-form-page.js"></script>
  </body>
</html>
