<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Header -->
                <div class="mb-4">
                    <h2 class="mb-1">
                        {{if .Attribute}}{{t $.Locale "Edit attribute"}}{{else}}{{t $.Locale "New attribute"}}{{end}} - {{.EntityType.Name}}
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/tools">Tools</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema">Database Schema</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit">{{.EntityType.Name}}</a></li>
                            <li class="breadcrumb-item active">{{if .Attribute}}{{t $.Locale "Edit attribute"}}{{else}}{{t $.Locale "New attribute"}}{{end}}</li>
                        </ol>
                    </nav>
                </div>

                <!-- Form Card -->
                <div class="card p-4">
                    <form method="POST" 
                          action="{{if .Attribute}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/{{.Attribute.ReferenceID}}/update{{else}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/attributes/new{{end}}"
                          class="needs-validation"
                          novalidate>
                        
                        <div class="mb-3">
                            <label for="attr_label" class="form-label">Label <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="attr_label" 
                                name="label" 
                                required
                                maxlength="100"
                                value="{{if .Attribute}}{{.Attribute.Label}}{{end}}"
                                placeholder="{{t $.Locale "e.g. Product name, Price, Delivery date"}}">
                            <div class="form-text">{{t $.Locale "Human-readable name"}}</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_machine_name" class="form-label">{{t $.Locale "Machine name"}} <span class="text-danger">*</span></label>
                            <input 
                                type="text" 
                                class="form-control font-monospace" 
                                id="attr_machine_name" 
                                name="machine_name" 
                                required
                                {{if not .Attribute}}pattern="[a-z][a-z0-9_]*"{{end}}
                                maxlength="100"
                                value="{{if .Attribute}}{{.Attribute.MachineName}}{{end}}"
                                {{if .Attribute}}readonly{{end}}
                                placeholder="{{t $.Locale "e.g. product_name, price, delivery_date"}}">
                            <div class="invalid-feedback">
                                {{t $.Locale "Lowercase letters, numbers and underscores only. Must start with a letter."}}
                            </div>
                            {{if .Attribute}}
                            <div class="form-text text-warning">⚠️ {{t $.Locale "Machine name cannot change after creation"}}</div>
                            {{else}}
                            <div class="form-text">{{t $.Locale "Unique identifier (generated from the label)"}}</div>
                            {{end}}
                        </div>

                        <div class="mb-3">
                            <label for="attr_help_text" class="form-label">{{t $.Locale "Help text"}}</label>
                            <textarea 
                                class="form-control" 
                                id="attr_help_text" 
                                name="help_text" 
                                rows="2"
                                maxlength="500"
                                placeholder="{{t $.Locale "Describe the purpose of this field…"}}">{{if .Attribute}}{{.Attribute.HelpText}}{{end}}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="attr_primitive_kind" class="form-label">{{t $.Locale "Type"}} <span class="text-danger">*</span></label>
                            <select class="form-select" id="attr_primitive_kind" name="primitive_kind" required {{if .Attribute}}disabled{{end}}>
                                <option value="">{{t $.Locale "Select a type…"}}</option>
                                <option value="BOOL" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "BOOL"}}selected{{end}}{{end}}>BOOL - {{t $.Locale "True/False"}}</option>
                                <option value="INT" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "INT"}}selected{{end}}{{end}}>INT - {{t $.Locale "Integer number"}}</option>
                                <option value="REAL" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "REAL"}}selected{{end}}{{end}}>REAL - {{t $.Locale "Decimal number"}}</option>
                                <option value="TEXT" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "TEXT"}}selected{{end}}{{end}}>TEXT - {{t $.Locale "Text"}}</option>
                                <option value="DATETIME" {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "DATETIME"}}selected{{end}}{{end}}>DATETIME - {{t $.Locale "Date/Time"}}</option>
                            </select>
                            {{if .Attribute}}
                            <input type="hidden" name="primitive_kind" value="{{.Attribute.PrimitiveKind}}">
                            <div class="form-text text-warning">⚠️ {{t $.Locale "Type cannot change after creation"}}</div>
                            {{end}}
                        </div>

                        <div class="mb-3" id="max_length_container" style="display: {{if .Attribute}}{{if eq .Attribute.PrimitiveKind "TEXT"}}block{{else}}none{{end}}{{else}}none{{end}};">
                            <label for="attr_max_length" class="form-label">{{t $.Locale "Maximum length (TEXT)"}}</label>
                            <input type="number" 
                                   class="form-control" 
                                   id="attr_max_length" 
                                   name="max_length" 
                                   min="1" 
                                   max="65535"
                                   value="{{if .Attribute}}{{if .Attribute.MaxLength}}{{.Attribute.MaxLength}}{{end}}{{end}}"
                                   placeholder="256">
                            <div class="form-text">{{t $.Locale "Maximum characters allowed (default: 256)"}}</div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_default_value" class="form-label">{{t $.Locale "Default value"}}</label>
                            <input type="text" 
                                   class="form-control" 
                                   id="attr_default_value" 
                                   name="default_value" 
                                   value="{{if .Attribute}}{{if eq .Attribute.PrimitiveKind "BOOL"}}{{if .Attribute.DefaultVBool}}{{if .Attribute.DefaultVBool}}1{{else}}0{{end}}{{end}}{{else if eq .Attribute.PrimitiveKind "INT"}}{{if .Attribute.DefaultVInt}}{{.Attribute.DefaultVInt}}{{end}}{{else if eq .Attribute.PrimitiveKind "REAL"}}{{if .Attribute.DefaultVReal}}{{.Attribute.DefaultVReal}}{{end}}{{else if eq .Attribute.PrimitiveKind "TEXT"}}{{if .Attribute.DefaultVText}}{{.Attribute.DefaultVText}}{{end}}{{else if eq .Attribute.PrimitiveKind "DATETIME"}}{{if .Attribute.DefaultVDatetime}}{{.Attribute.DefaultVDatetime}}{{end}}{{end}}{{end}}"
                                   {{if not .Attribute}}disabled{{end}}
                                   placeholder="{{t $.Locale "Pick a type first"}}">
                            <div class="form-text">{{t $.Locale "Initial value for new records (user editable)"}}</div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_required" name="is_required" value="1" {{if .Attribute}}{{if .Attribute.IsRequired}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_required">
                                    {{t $.Locale "Required field"}}
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_unique" name="is_unique" value="1" {{if .Attribute}}{{if .Attribute.IsUnique}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_unique">
                                    {{t $.Locale "Unique value (no duplicates)"}}
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_indexed" name="is_indexed" value="1" {{if .Attribute}}{{if .Attribute.IsIndexed}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_indexed">
                                    {{t $.Locale "Create an index (faster searches)"}}
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="attr_is_computed" name="is_computed" value="1" {{if .Attribute}}{{if .Attribute.IsComputed}}checked{{end}}{{end}}>
                                <label class="form-check-label" for="attr_is_computed">
                                    {{t $.Locale "Computed field (Filo)"}}
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="attr_computed_expr" class="form-label">{{t $.Locale "Computed expression (Filo)"}}</label>
                            <textarea class="form-control font-monospace"
                                      id="attr_computed_expr"
                                      name="computed_expr"
                                      rows="3"
                                      placeholder='(* field:price field:quantity)'>{{if .Attribute}}{{.Attribute.ComputedExpr}}{{end}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Recomputed on every save, overwriting typed input. Fields read as"}} <code>field:&lt;name&gt;</code>.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                {{if .Attribute}}{{t $.Locale "Update attribute"}}{{else}}{{t $.Locale "Create attribute"}}{{end}}
                            </button>
                            <a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit" class="btn btn-secondary">
                                {{t $.Locale "Cancel"}}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    {{template "footer" .}}
    {{template "scripts" .}}
    
    <script defer src="/assets/slugify.js"></script>
    <script defer src="/assets/eav-attribute-form-page.js"></script>
  </body>
</html>
