<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-4 py-md-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="badge bg-info mb-1">PREVIEW</span>
                            <h2 class="mb-0">{{.Form.Label}}</h2>
                        </div>
                        <a href="/tools/forms/{{.Form.ReferenceID}}/edit" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar ao Editor
                        </a>
                    </div>
                    
                    {{if .Form.Description}}
                    <p class="text-muted">{{.Form.Description}}</p>
                    {{end}}
                    
                    <hr>
                    
                    <form>
                        {{if .Elements}}
                            {{range .Elements}}
                            <div class="mb-3" id="field-{{.ReferenceID}}">
                                {{if eq .ElementKind "divider"}}
                                    <hr class="my-4">
                                {{else if eq .ElementKind "group"}}
                                    <fieldset class="border rounded p-3 mb-3">
                                        <legend class="h6">{{.Label}}</legend>
                                        <!-- Group elements would be nested here -->
                                    </fieldset>
                                {{else}}
                                    {{if .Label}}
                                    <label class="form-label">
                                        {{.Label}}
                                    </label>
                                    {{end}}
                                    
                                    <!-- Render based on UI kind -->
                                    {{if eq .UIKind "textarea"}}
                                        <textarea class="form-control" rows="3" disabled></textarea>
                                    {{else if eq .UIKind "checkbox"}}
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" disabled>
                                            <label class="form-check-label">{{.Label}}</label>
                                        </div>
                                    {{else if eq .UIKind "select"}}
                                        <select class="form-select" disabled>
                                            <option>Opção 1</option>
                                            <option>Opção 2</option>
                                        </select>
                                    {{else}}
                                        <input type="text" class="form-control" disabled placeholder="{{.HelpText}}">
                                    {{end}}
                                    
                                    {{if .HelpText}}
                                    <div class="form-text">{{.HelpText}}</div>
                                    {{end}}
                                {{end}}
                            </div>
                            {{end}}
                        {{else}}
                            <div class="alert alert-secondary">
                                <i class="bi bi-info-circle"></i> Este formulário não possui elementos. 
                                <a href="/tools/forms/{{.Form.ReferenceID}}/edit">Adicione elementos no editor</a>.
                            </div>
                        {{end}}
                        
                        <hr>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" disabled>Salvar (preview)</button>
                            <button type="button" class="btn btn-secondary" disabled>Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
