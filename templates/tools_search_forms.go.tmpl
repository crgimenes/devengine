<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="mb-1">{{t $.Locale "Global search"}}</h2>
                        <p class="text-muted mb-0">{{t $.Locale "One query across the text fields of every table."}}</p>
                    </div>
                </div>

                <form method="get" action="/tools/search-forms" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" maxlength="100"
                               value="{{.Query}}" placeholder="{{t $.Locale "Type and press Enter"}}"
                               autofocus>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>{{t $.Locale "Search"}}
                        </button>
                    </div>
                </form>

                {{if .Searched}}
                    {{if .Groups}}
                        {{range .Groups}}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-database me-2"></i>{{.EntityType.Name}}</span>
                                {{if .HasMore}}
                                    {{if .FormRefID}}
                                    <a href="/tools/forms/{{.FormRefID}}/records?q={{$.Query}}" class="small">{{t $.Locale "See all results"}}</a>
                                    {{else}}
                                    <a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/records" class="small">{{t $.Locale "See all records"}}</a>
                                    {{end}}
                                {{end}}
                            </div>
                            <div class="list-group list-group-flush">
                                {{$et := .EntityType}}
                                {{range .Hits}}
                                <a href="/tools/database-schema/eav/{{$et.ReferenceID}}/records/{{.RefID}}/edit"
                                   class="list-group-item list-group-item-action">
                                    {{.Summary}}
                                </a>
                                {{end}}
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-search fs-1 d-block mb-2"></i>
                            {{t $.Locale "No records match %q" .Query}}
                        </div>
                    {{end}}
                {{end}}
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
