<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">{{t $.Locale "Edit item"}}</h2>
                        <a href="/tools/menu-editor/{{.Menu.ReferenceID}}/edit" class="btn btn-outline-secondary">{{t $.Locale "Back"}}</a>
                    </div>
                    
                    {{if .Error}}
                    <div class="alert alert-danger">{{.Error}}</div>
                    {{end}}

                    <form method="post" action="/tools/menu-editor/{{.Menu.ReferenceID}}/items/{{.Item.ReferenceID}}/update">
                        <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="label" class="form-label">Label</label>
                                <input type="text" class="form-control" id="label" name="label" 
                                       value="{{.Item.Label}}" required>
                                <div class="form-text">{{t $.Locale "Text shown in the menu"}}</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="machine_name" class="form-label">{{t $.Locale "Machine name"}}</label>
                                <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                       value="{{.Item.MachineName}}" required pattern="[a-z][a-z0-9_]*">
                                <div class="form-text">{{t $.Locale "Unique identifier of the item"}}</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="icon" class="form-label">{{t $.Locale "Icon"}}</label>
                                <input type="text" class="form-control" id="icon" name="icon" 
                                       value="{{.Item.Icon}}" placeholder="bi-house">
                                <div class="form-text">{{t $.Locale "Bootstrap Icons class"}} (<a href="https://icons.getbootstrap.com/" target="_blank">{{t $.Locale "browse icons"}}</a>)</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="parent_id" class="form-label">{{t $.Locale "Parent item"}}</label>
                                <select class="form-select" id="parent_id" name="parent_id">
                                    <option value="">{{t $.Locale "- None (root) -"}}</option>
                                    {{range .AllItems}}
                                    {{if ne .ID $.Item.ID}}
                                    <option value="{{.ReferenceID}}" {{if and $.Item.ParentID (eq .ID (deref $.Item.ParentID))}}selected{{end}}>
                                        {{.Label}} ({{.MachineName}})
                                    </option>
                                    {{end}}
                                    {{end}}
                                </select>
                                <div class="form-text">Nests this item under another item</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="item_type" class="form-label">{{t $.Locale "Type"}}</label>
                                <select class="form-select" id="item_type" name="item_type">
                                    <option value="link" {{if eq .Item.ItemType "link"}}selected{{end}}>Link</option>
                                    <option value="submenu" {{if eq .Item.ItemType "submenu"}}selected{{end}}>Submenu</option>
                                    <option value="separator" {{if eq .Item.ItemType "separator"}}selected{{end}}>Separator</option>
                                </select>
                                <div class="form-text">Defines what the item does</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="url" class="form-label">{{t $.Locale "Link (URL)"}}</label>
                                <input type="text" class="form-control" id="url" name="url" 
                                       value="{{.Item.URL}}" placeholder="/example or https://...">
                                <div class="form-text">{{t $.Locale "URL for direct navigation"}}</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="js_code" class="form-label">{{t $.Locale "JavaScript code"}}</label>
                            <textarea class="form-control font-monospace" id="js_code" name="js_code" rows="4" 
                                      placeholder="alert('Hello!');&#10;console.log('test');">{{.Item.JSCode}}</textarea>
                            <div class="form-text">{{t $.Locale "JavaScript run on the client when the item is clicked"}}</div>
                        </div>

                        <div class="mb-3">
                            <label for="filo_code" class="form-label">{{t $.Locale "Filo code"}}</label>
                            <textarea class="form-control font-monospace" id="filo_code" name="filo_code" rows="4"
                                      placeholder="(let () (print &quot;Executed on the server&quot;))">{{.Item.FiloCode}}</textarea>
                            <div class="form-text">{{t $.Locale "Filo code run on the server when the item is clicked"}}</div>
                        </div>

                        <div class="alert alert-info mb-3">
                            <strong>{{t $.Locale "Execution order:"}}</strong> Filo → JavaScript → Link.
                            {{t $.Locale "If the Filo code returns an error or a redirect, the following steps are skipped."}}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">{{t $.Locale "Save"}}</button>
                            <a href="/tools/menu-editor/{{.Menu.ReferenceID}}/edit" class="btn btn-outline-secondary">{{t $.Locale "Cancel"}}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
