<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
        <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
            {{.Message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{end}}

        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="mb-1">Ferramentas</h2>
                        <p class="text-muted mb-0">Administração do sistema.</p>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 g-3">
                    {{template "tool_card" (dict
                        "Title" "Database Schema"
                        "Description" "Definir entity types EAV, atributos tipados e scripts Filo de pre_save / pos_load."
                        "URL" "/tools/database-schema"
                        "Icon" "bi-database")}}

                    {{template "tool_card" (dict
                        "Title" "Forms"
                        "Description" "Construir formulários sobre EAV: elementos, hierarquia, validações e botões."
                        "URL" "/tools/forms"
                        "Icon" "bi-input-cursor-text")}}

                    {{template "tool_card" (dict
                        "Title" "Usuários"
                        "Description" "Listar, editar, promover, desabilitar e resetar senha de usuários."
                        "URL" "/tools/users"
                        "Icon" "bi-people")}}

                    {{template "tool_card" (dict
                        "Title" "Convites"
                        "Description" "Gerar links de convite de uso único para novos usuários."
                        "URL" "/tools/invites"
                        "Icon" "bi-envelope-plus")}}

                    {{template "tool_card" (dict
                        "Title" "Menu Editor"
                        "Description" "Definir menus de navegação reutilizáveis com itens recursivos e ações Filo."
                        "URL" "/tools/menu-editor"
                        "Icon" "bi-list-nested")}}

                    {{template "tool_card" (dict
                        "Title" "Filo REPL"
                        "Description" "Testar scripts Filo com os mesmos builtins do runtime (str-*, eav-*, file-*, session-*)."
                        "URL" "/tools/filo"
                        "Icon" "bi-terminal")}}

                    {{template "tool_card" (dict
                        "Title" "Busca Global"
                        "Description" "Busca global: uma consulta sobre os campos de texto de todas as tabelas."
                        "URL" "/tools/search-forms"
                        "Icon" "bi-search")}}
                </div>
            </div>
        </div>
    </main>

    <footer>{{template "footer" .}}</footer>
    {{template "scripts" .}}
  </body>
</html>

{{define "tool_card"}}
<div class="col">
    <a href="{{.URL}}" class="card h-100 text-decoration-none {{if .Soon}}opacity-50{{end}}">
        <div class="card-body">
            <div class="d-flex align-items-center mb-2">
                <i class="bi {{.Icon}} fs-3 me-2"></i>
                <h5 class="card-title mb-0">{{.Title}}</h5>
                {{if .Soon}}<span class="badge bg-secondary ms-2">em breve</span>{{end}}
            </div>
            <p class="card-text text-muted small mb-0">{{.Description}}</p>
        </div>
    </a>
</div>
{{end}}
