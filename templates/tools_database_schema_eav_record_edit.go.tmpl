<!doctype html>
<html lang="{{$.Locale}}" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        {{if .PosLoadError}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                <strong>Aviso:</strong> {{.PosLoadError}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Header -->
                <div class="mb-4">
                    <h2 class="mb-1">
                        {{if .Record}}{{t $.Locale "Edit record"}}{{else}}{{t $.Locale "New record"}}{{end}} - {{.EntityType.Name}}
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/tools">Tools</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema">Database Schema</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/edit">{{.EntityType.Name}}</a></li>
                            <li class="breadcrumb-item"><a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/records">{{t $.Locale "Records"}}</a></li>
                            <li class="breadcrumb-item active">{{if .Record}}{{t $.Locale "Edit"}}{{else}}{{t $.Locale "New"}}{{end}}</li>
                        </ol>
                    </nav>
                </div>

                <!-- Form Card -->
                <div class="card p-4">
                    <form method="POST" 
                          action="{{if .Record}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/records/{{.Record.ReferenceID}}/update{{else}}/tools/database-schema/eav/{{.EntityType.ReferenceID}}/records/new{{end}}"
                          class="needs-validation record-form"
                          novalidate>
                        
                        {{if .Record}}
                            <input type="hidden" name="rev" value="{{.Record.Rev}}">
                            <div class="mb-3">
                                <span class="badge bg-secondary font-monospace">{{.Record.ReferenceID}}</span>
                                {{if eq .Record.Status "active"}}
                                    <span class="badge bg-success">Ativo</span>
                                {{else}}
                                    <span class="badge bg-warning">Rascunho</span>
                                {{end}}
                                <small class="text-muted ms-2">Rev: {{.Record.Rev}}</small>
                            </div>
                        {{end}}

                        {{range .Attributes}}
                            {{if not .IsComputed}}
                            <div class="mb-3">
                                <label for="attr_{{.MachineName}}" class="form-label">
                                    {{.Label}}
                                    {{if .IsRequired}}<span class="text-danger">*</span>{{end}}
                                </label>
                                
                                {{$value := index $.Values .MachineName}}
                                
                                {{if eq .PrimitiveKind "BOOL"}}
                                    <select class="form-select" 
                                            id="attr_{{.MachineName}}" 
                                            name="attr_{{.MachineName}}"
                                            {{if .IsRequired}}required{{end}}>
                                        <option value="">{{t $.Locale "Select…"}}</option>
                                        <option value="0" {{if eq $value false}}selected{{end}}>{{t $.Locale "No"}}</option>
                                        <option value="1" {{if eq $value true}}selected{{end}}>{{t $.Locale "Yes"}}</option>
                                    </select>
                                {{else if eq .PrimitiveKind "INT"}}
                                    <input type="number" 
                                           class="form-control" 
                                           id="attr_{{.MachineName}}" 
                                           name="attr_{{.MachineName}}"
                                           step="1"
                                           value="{{$value}}"
                                           {{if .IsRequired}}required{{end}}>
                                {{else if eq .PrimitiveKind "REAL"}}
                                    <input type="number" 
                                           class="form-control" 
                                           id="attr_{{.MachineName}}" 
                                           name="attr_{{.MachineName}}"
                                           step="any"
                                           value="{{$value}}"
                                           {{if .IsRequired}}required{{end}}>
                                {{else if eq .PrimitiveKind "TEXT"}}
                                    <textarea class="form-control" 
                                              id="attr_{{.MachineName}}" 
                                              name="attr_{{.MachineName}}"
                                              rows="3"{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}
                                              {{if .IsRequired}}required{{end}}>{{$value}}</textarea>
                                    {{if .MaxLength}}
                                    <div class="form-text">{{t $.Locale "Maximum: %d characters" (derefInt .MaxLength)}}</div>
                                    {{end}}
                                {{else if eq .PrimitiveKind "DATETIME"}}
                                    <input type="datetime-local" 
                                           class="form-control" 
                                           id="attr_{{.MachineName}}" 
                                           name="attr_{{.MachineName}}"
                                           value="{{$value}}"
                                           {{if .IsRequired}}required{{end}}>
                                {{end}}
                                
                                {{if .HelpText}}
                                    <div class="form-text">{{.HelpText}}</div>
                                {{end}}
                                
                                {{if .IsUnique}}
                                    <div class="form-text text-warning">⚠️ {{t $.Locale "This field must be unique"}}</div>
                                {{end}}
                            </div>
                            {{end}}
                        {{end}}

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                {{if .Record}}{{t $.Locale "Update record"}}{{else}}{{t $.Locale "Create record"}}{{end}}
                            </button>
                            <a href="/tools/database-schema/eav/{{.EntityType.ReferenceID}}/records" class="btn btn-secondary">
                                {{t $.Locale "Cancel"}}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    {{template "footer" .}}
    {{template "scripts" .}}
    <script src="/assets/eav-record-form.js"></script>
  </body>
</html>
