<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">Menu Editor</h2>
                        <a href="/tools/menu-editor/new" class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i> {{t $.Locale "New menu"}}
                        </a>
                    </div>
                    <p class="text-muted">{{t $.Locale "Manage the navigation menus."}}</p>
                    
                    {{if .Menus}}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>{{t $.Locale "Name"}}</th>
                                    <th>Identificador</th>
                                    <th>{{t $.Locale "Description"}}</th>
                                    <th class="text-end">{{t $.Locale "Actions"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{range .Menus}}
                                <tr>
                                    <td>
                                        <a href="/tools/menu-editor/{{.ReferenceID}}/edit">{{.Label}}</a>
                                    </td>
                                    <td><code>{{.MachineName}}</code></td>
                                    <td>{{.Description}}</td>
                                    <td class="text-end">
                                        <a href="/tools/menu-editor/{{.ReferenceID}}/preview" class="btn btn-sm btn-success me-1">Testar</a>
                                        <a href="/tools/menu-editor/{{.ReferenceID}}/edit" class="btn btn-sm btn-outline-primary me-1">{{t $.Locale "Edit"}}</a>
                                        <form method="post" action="/tools/menu-editor/{{.ReferenceID}}/delete" class="d-inline" onsubmit="return confirm('{{t $.Locale "Delete this menu?"}}')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">{{t $.Locale "Delete"}}</button>
                                        </form>
                                    </td>
                                </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>
                    {{else}}
                    <div class="alert alert-secondary">
                        <i class="bi bi-info-circle"></i> {{t $.Locale "No menus yet."}}
                        <a href="/tools/menu-editor/new">{{t $.Locale "Create the first menu"}}</a>.
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
