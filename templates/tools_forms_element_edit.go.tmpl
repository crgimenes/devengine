<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid py-4 py-md-5">
        {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                {{.Message}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{end}}
        
        <div class="row">
            <div class="col-md-3">
                {{template "tools_sidebar" .}}
            </div>
            <div class="col-md-9">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/tools/forms">{{t $.Locale "Forms"}}</a></li>
                        <li class="breadcrumb-item"><a href="/tools/forms/{{.Form.ReferenceID}}/edit">{{.Form.Label}}</a></li>
                        <li class="breadcrumb-item active" aria-current="page">{{.Element.MachineName}}</li>
                    </ol>
                </nav>

                <div class="card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-1">Editar Elemento</h2>
                            <small class="text-muted">{{.Element.MachineName}}</small>
                        </div>
                        <a href="/tools/forms/{{.Form.ReferenceID}}/edit" class="btn btn-secondary">{{t $.Locale "Back"}}</a>
                    </div>
                    
                    <form method="post" action="/tools/forms/{{.Form.ReferenceID}}/elements/{{.Element.ReferenceID}}/update">
                        <!-- Basic Info -->
                        <h5 class="mb-3 border-bottom pb-2">{{t $.Locale "Basics"}}</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="machine_name" class="form-label">{{t $.Locale "Machine name"}} <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="machine_name" name="machine_name" 
                                       value="{{.Element.MachineName}}" required pattern="[a-zA-Z][a-zA-Z0-9_]*">
                                <div class="form-text">{{t $.Locale "Unique identifier within the form"}}</div>
                            </div>
                            <div class="col-md-6">
                                <label for="label" class="form-label">Label</label>
                                <input type="text" class="form-control" id="label" name="label" 
                                       value="{{.Element.Label}}" placeholder="{{t $.Locale "Visible title"}}">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="help_text" class="form-label">{{t $.Locale "Help text"}}</label>
                            <textarea class="form-control" id="help_text" name="help_text" rows="2">{{.Element.HelpText}}</textarea>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label for="element_kind" class="form-label">Tipo de Elemento</label>
                                <select class="form-select" id="element_kind" name="element_kind">
                                    <option value="field" {{if eq .Element.ElementKind "field"}}selected{{end}}>Campo</option>
                                    <option value="group" {{if eq .Element.ElementKind "group"}}selected{{end}}>Grupo (fieldset)</option>
                                    <option value="accordion" {{if eq .Element.ElementKind "accordion"}}selected{{end}}>Accordion</option>
                                    <option value="card" {{if eq .Element.ElementKind "card"}}selected{{end}}>Card</option>
                                    <option value="tabs" {{if eq .Element.ElementKind "tabs"}}selected{{end}}>Tabs</option>
                                    <option value="carousel" {{if eq .Element.ElementKind "carousel"}}selected{{end}}>Carousel</option>
                                    <option value="button" {{if eq .Element.ElementKind "button"}}selected{{end}}>{{t $.Locale "Action button"}}</option>
                                    <option value="divider" {{if eq .Element.ElementKind "divider"}}selected{{end}}>Divisor</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="ui_kind" class="form-label">Plugin de UI</label>
                                <select class="form-select" id="ui_kind" name="ui_kind">
                                    <option value="" {{if eq .Element.UIKind ""}}selected{{end}}>-- {{t $.Locale "Default"}} --</option>
                                    {{$current := .Element.UIKind}}
                                    {{range .UIKinds}}
                                    <option value="{{.}}" {{if eq $current .}}selected{{end}}>{{.}}</option>
                                    {{end}}
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="eav_attribute_id" class="form-label">Atributo EAV</label>
                                <select class="form-select" id="eav_attribute_id" name="eav_attribute_id">
                                    <option value="">-- Apenas UI --</option>
                                    {{range .EAVAttributes}}
                                    <option value="{{.ReferenceID}}" {{if $.Element.EAVAttributeID}}{{if eq .ID (deref $.Element.EAVAttributeID)}}selected{{end}}{{end}}>
                                        {{.Label}} ({{.MachineName}})
                                    </option>
                                    {{end}}
                                </select>
                            </div>
                        </div>

                        <!-- Layout -->
                        <h5 class="mb-3 border-bottom pb-2">Layout e Hierarquia</h5>
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <label for="parent_id" class="form-label">Grupo Pai</label>
                                <select class="form-select" id="parent_id" name="parent_id">
                                    <option value="">-- {{t $.Locale "Form root"}} --</option>
                                    {{range .GroupElements}}
                                    <option value="{{.ReferenceID}}" {{if $.Element.ParentID}}{{if eq .ID (deref $.Element.ParentID)}}selected{{end}}{{end}}>
                                        {{if .Label}}{{.Label}}{{else}}{{.MachineName}}{{end}} ({{.ElementKind}})
                                    </option>
                                    {{end}}
                                </select>
                                <div class="form-text">Coloque este elemento dentro de um grupo</div>
                            </div>
                            <div class="col-md-2">
                                <label for="z_order" class="form-label">{{t $.Locale "Order"}}</label>
                                <input type="number" class="form-control" id="z_order" name="z_order" 
                                       value="{{.Element.ZOrder}}" min="0">
                                <div class="form-text">Menor = primeiro</div>
                            </div>
                            <div class="col-md-3">
                                <label for="col_span" class="form-label">{{t $.Locale "Width (columns)"}}</label>
                                <select class="form-select" id="col_span" name="col_span">
                                    {{range $i := (seq 1 12)}}
                                    <option value="{{$i}}" {{if eq $i $.Element.ColSpan}}selected{{end}}>
                                        {{$i}} {{if eq $i 12}}(Total){{else if eq $i 6}}(1/2){{else if eq $i 4}}(1/3){{else if eq $i 3}}(1/4){{end}}
                                    </option>
                                    {{end}}
                                </select>
                                <div class="form-text">Sistema de 12 colunas</div>
                            </div>
                            <div class="col-md-4">
                                <label for="alignment" class="form-label">{{t $.Locale "Horizontal alignment"}}</label>
                                <select class="form-select" id="alignment" name="alignment">
                                    <option value="left" {{if eq .Element.Alignment "left"}}selected{{end}}>Esquerda</option>
                                    <option value="center" {{if eq .Element.Alignment "center"}}selected{{end}}>Centralizado</option>
                                    <option value="right" {{if eq .Element.Alignment "right"}}selected{{end}}>Direita</option>
                                </select>
                                <div class="form-text">{{t $.Locale "Position when narrower than 12 columns"}}</div>
                            </div>
                        </div>

                        <!-- Options -->
                        <h5 class="mb-3 border-bottom pb-2">{{t $.Locale "Options"}}</h5>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="is_ui_only" name="is_ui_only" 
                                           {{if .Element.IsUIOnly}}checked{{end}}>
                                    <label class="form-check-label" for="is_ui_only">
                                        {{t $.Locale "UI only (does not persist data)"}}
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="is_readonly" name="is_readonly"
                                           {{if .Element.IsReadonly}}checked{{end}}>
                                    <label class="form-check-label" for="is_readonly">
                                        Somente Leitura
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="hide_label" name="hide_label"
                                           {{if .Element.HideLabel}}checked{{end}}>
                                    <label class="form-check-label" for="hide_label">
                                        {{t $.Locale "Hide title"}}
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="hide_help_text" name="hide_help_text"
                                           {{if .Element.HideHelpText}}checked{{end}}>
                                    <label class="form-check-label" for="hide_help_text">
                                        {{t $.Locale "Hide description"}}
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Plugin Options Panel -->
                        <h5 class="mb-3 border-bottom pb-2">{{t $.Locale "Plugin options"}}</h5>
                        <datalist id="entity-machine-names">
                            {{range .EntityTypes}}<option value="{{.MachineName}}">{{.Name}}</option>{{end}}
                        </datalist>
                        <datalist id="attribute-machine-names">
                            {{range .AttributeNames}}<option value="{{.}}"></option>{{end}}
                        </datalist>
                        {{template "plugin_options_panel" (dict "Meta" (parseGroupMeta .Element.UIMetaJSON .Element.ElementKind) "ElementKind" .Element.ElementKind "Locale" $.Locale)}}

                        <!-- UI Meta JSON -->
                        <h5 class="mb-3 border-bottom pb-2">{{t $.Locale "Advanced settings (JSON)"}}</h5>
                        <div class="mb-4">
                            <label for="ui_meta_json" class="form-label">Metadados do Plugin</label>
                            <textarea class="form-control font-monospace" id="ui_meta_json" name="ui_meta_json" 
                                      rows="4" placeholder='{"placeholder": "Digite aqui...", "maxLength": 100}'>{{.Element.UIMetaJSON}}</textarea>
                            <div class="form-text">JSON livre interpretado pelo plugin (ex.: reference: {"entity": "cliente", "display": "nome"}).</div>
                        </div>

                        <div class="mb-3">
                            <label for="validate_expr" class="form-label">{{t $.Locale "Validation (Filo)"}}</label>
                            <textarea class="form-control font-monospace"
                                      id="validate_expr"
                                      name="validate_expr"
                                      rows="3"
                                      placeholder='(if (< field:quantidade 1) "Quantidade deve ser ao menos 1" "")'>{{.Element.ValidateExpr}}</textarea>
                            <div class="form-text">
                                {{t $.Locale "Runs on save. Return an error string (empty = ok) or a boolean (false = invalid). Fields read as"}} <code>field:&lt;name&gt;</code>.
                            <div class="form-text">{{t $.Locale "Updated automatically by the options above"}}</div>
                        </div>

                        <!-- Button-specific Options (only shown when element_kind = button) -->
                        <div id="button_options" class="{{if ne .Element.ElementKind "button"}}d-none{{end}}">
                            <h5 class="mb-3 border-bottom pb-2">{{t $.Locale "Button settings"}}</h5>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="button_style" class="form-label">Estilo</label>
                                    <select class="form-select" id="button_style" name="button_style">
                                        <option value="primary" {{if eq .Element.ButtonStyle "primary"}}selected{{end}}>Primary (Azul)</option>
                                        <option value="secondary" {{if eq .Element.ButtonStyle "secondary"}}selected{{end}}>Secondary (Cinza)</option>
                                        <option value="success" {{if eq .Element.ButtonStyle "success"}}selected{{end}}>Success (Verde)</option>
                                        <option value="danger" {{if eq .Element.ButtonStyle "danger"}}selected{{end}}>Danger (Vermelho)</option>
                                        <option value="warning" {{if eq .Element.ButtonStyle "warning"}}selected{{end}}>Warning (Amarelo)</option>
                                        <option value="info" {{if eq .Element.ButtonStyle "info"}}selected{{end}}>Info (Ciano)</option>
                                        <option value="outline-primary" {{if eq .Element.ButtonStyle "outline-primary"}}selected{{end}}>Outline Primary</option>
                                        <option value="outline-secondary" {{if eq .Element.ButtonStyle "outline-secondary"}}selected{{end}}>Outline Secondary</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="button_confirm_msg" class="form-label">{{t $.Locale "Confirmation message"}}</label>
                                    <input type="text" class="form-control" id="button_confirm_msg" name="button_confirm_msg"
                                           value="{{.Element.ButtonConfirmMsg}}"
                                           placeholder="{{t $.Locale "Are you sure you want to continue?"}}">
                                    <div class="form-text">{{t $.Locale "Leave empty to skip the confirmation"}}</div>
                                </div>
                            </div>
                            
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="button_run_save" name="button_run_save"
                                       {{if .Element.ButtonRunSave}}checked{{end}}>
                                <label class="form-check-label" for="button_run_save">
                                    {{t $.Locale "Run the save action (same transaction)"}}
                                </label>
                                <div class="form-text">{{t $.Locale "Saves the record before running the Filo code"}}</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="button_filo_code" class="form-label">{{t $.Locale "Filo code (server)"}}</label>
                                <textarea class="form-control font-monospace" id="button_filo_code" name="button_filo_code" 
                                          rows="6" placeholder=";; Available variables: form_*, user_*, the form fields
;; Control variables: error, message, redirect_to">{{.Element.ButtonFiloCode}}</textarea>
                                <div class="form-text">{{t $.Locale "Runs on the server. Never visible to the user."}}</div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="button_js_code" class="form-label">JavaScript (cliente)</label>
                                <textarea class="form-control font-monospace" id="button_js_code" name="button_js_code" 
                                          rows="4" placeholder="// formData holds the form data
// return false to cancel the action">{{.Element.ButtonJSCode}}</textarea>
                                <div class="form-text">Executado no navegador antes de enviar ao servidor. Retorne false para cancelar.</div>
                            </div>
                        </div>

                        <hr>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">{{t $.Locale "Save changes"}}</button>
                            <a href="/tools/forms/{{.Form.ReferenceID}}/edit" class="btn btn-secondary">{{t $.Locale "Cancel"}}</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/plugin-options.js"></script>
    <script src="/assets/button-options.js"></script>
  </body>
</html>
